#!/usr/bin/env python3
"""tk-vista-check — does this HTML file qualify as a *vista*?

A vista is the visual companion of a package digest: a page the human READS to
give a verdict, written to the outbox and thrown away. It is never a source, so
nothing is read back from it — which leaves exactly two properties a machine can
still check, and both are checked here.

Four properties are checkable without a human: the page fetches nothing, the
five blocks are there, the palette covers both themes, and nothing prints that
the author never meant to publish. Whether the prose is worth reading is the
reader's question, and no checker replaces it.

SELF-CONTAINED. The page opens from a local file, on a machine that may be
offline, months after the session that wrote it. So every byte it renders is
already inside it: no stylesheet, script, font, image or fetch reaching out.
The rule this script enforces is narrower than "no http", because a vista MUST
carry links — block 4 of the contract is the link to each slice's proof, which
lives in the PR. The distinction is what the browser LOADS versus where the
reader CLICKS:

  - a URL the browser fetches to render the page (src, <link href>, @import,
    CSS url(), a network call in script) must be `data:` or a `#` fragment;
  - `<a href="...">` may point anywhere, since it loads nothing until a human
    clicks it, and clicking is the point.

A RELATIVE path is refused by the same rule, and deliberately: `src="logo.png"`
costs no network but breaks the moment the file is copied anywhere alone, which
is the normal life of an outbox file.

THE FIVE BLOCKS. The contract (`../reference/vista.md`) fixes five blocks and
leaves the layout free, so the blocks are found by MARKER, never by shape:
`data-vista-bloco` names a region, `data-vista-card` marks one card, and a card
carries its outcome and its risk tag as attributes. A checker looking for a
heading text or a CSS class would fail the next page that renders the same
contract differently — which is every page, the layout being free.

Usage:  tk-vista-check <file.html> [<file.html> ...]
Exit:   0 every file qualifies · 1 some file does not · 2 bad usage/unreadable
"""

import argparse
import os
import re
import sys
from html.parser import HTMLParser

# Attributes whose value the browser FETCHES. `href` is here too, and the `<a>`
# exemption is applied where the tag is known — not by dropping href from the
# list, which would also exempt <link rel=stylesheet>
URL_ATTRS = {
    "src", "srcset", "poster", "data", "href", "action", "formaction",
    "background", "cite", "longdesc", "manifest", "xlink:href", "codebase",
}

# Network APIs, looked for inside <script> and event-handler attributes only:
# the same words in the page's prose are prose
NETWORK_CALLS = re.compile(
    r"\b(fetch|XMLHttpRequest|WebSocket|EventSource|importScripts)\s*\(" 
    r"|\bnavigator\s*\.\s*sendBeacon\b"
    r"|\bimport\s*\("
)

CSS_URL = re.compile(r"url\(\s*(['\"]?)([^'\")]*)\1\s*\)", re.IGNORECASE)
CSS_IMPORT = re.compile(r"@import\b", re.IGNORECASE)
DARK_THEME = re.compile(r"prefers-color-scheme\s*:\s*dark", re.IGNORECASE)

VOID = {"area", "base", "br", "col", "embed", "hr", "img", "input", "link",
        "meta", "param", "source", "track", "wbr"}

# Marker -> the block's number and the name a refusal prints. The three
# page-level blocks are checked from this table; the per-card ones (2's
# outcome, 3's risk tag, 4's proof link) are checked card by card, reading
# their name from the same place. One table, so the check and the list beside
# it cannot drift apart
BLOCKS = {
    "stats": (1, "the opening stats line"),
    "cards": (2, "the cards region"),
    "prova": (4, "the slice's proof"),
    "saldo": (5, "closed × open balance"),
}
CARD_BLOCK = "prova"                       # the one checked card by card
PAGE_BLOCKS = tuple(m for m in BLOCKS if m != CARD_BLOCK)


def local(url):
    """True when the browser can resolve `url` without leaving this file."""
    u = (url or "").strip()
    if u.startswith("#"):
        return True
    # everything else has to be inline. An EMPTY value falls through to False on
    # purpose: `src=""` is not "no URL", it resolves to the page and refetches it
    return u.lower().startswith("data:")


class Vista(HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.loose = []          # text printed outside the structure the page declared
        # `<html>` and `<body>` are optional in HTML5: a page that declares
        # neither keeps its text at depth zero legitimately, and refusing that
        # would refuse the free layout the contract promises
        self.declared_structure = False
        self.stack = []          # open tags, innermost last
        self.cards = []          # one dict per card found
        self.open_cards = []     # indices into self.cards, innermost last
        self.blocks = set()      # data-vista-bloco values seen anywhere
        self.css = []            # every stylesheet-ish string in the document
        self.script = []         # every script body and event handler
        self.external = []       # (tag, attr, value)
        self.in_script = False

    # -- traversal ---------------------------------------------------------
    def handle_starttag(self, tag, attrs):
        opened_card = self._element(tag, attrs)
        if tag == "script":
            # only here: `<script/>` closes where it opens, and a flag set in
            # the shared element reader would stay on for the rest of the file
            self.in_script = True
        if tag not in VOID:
            self.stack.append(tag)
            if opened_card:
                self.open_cards.append(len(self.cards) - 1)

    def handle_startendtag(self, tag, attrs):
        # `<article data-vista-card/>` closes where it opens: it is a card, and
        # it never becomes the container a later prova link is counted into
        self._element(tag, attrs)

    def handle_endtag(self, tag):
        if tag == "script":
            self.in_script = False
        if tag in self.stack:
            # pop through the tags an unclosed <p> or <li> left behind, so one
            # sloppy element cannot detach every card boundary below it
            while self.stack:
                open_tag = self.stack.pop()
                depth = len(self.stack)
                while self.open_cards and self.cards[self.open_cards[-1]]["depth"] >= depth:
                    self.open_cards.pop()
                if open_tag == tag:
                    break

    def handle_data(self, data):
        if self.in_script:
            self.script.append(data)
        elif self.stack and self.stack[-1] == "style":
            self.css.append(data)
        elif not self.stack and data.strip():
            # text outside every element, which the browser prints at the top
            # of the page. A comment holding a nested `<!-- ... -->` ENDS at
            # the first `-->`, and the rest of what the author meant as a note
            # lands here — measured on this repo's own template
            self.loose.append(" ".join(data.split())[:60])

    # -- one element -------------------------------------------------------
    def _element(self, tag, attrs):
        """Read one element; True when it opened a card."""
        a = {k.lower(): (v or "") for k, v in attrs}
        if tag in ("html", "body"):
            self.declared_structure = True
        for name, value in a.items():
            if name in URL_ATTRS:
                if tag == "a" and name == "href":
                    continue        # a link the human clicks loads nothing now
                for url in (value.split(",") if name == "srcset" else [value]):
                    url = url.strip().split(" ")[0] if name == "srcset" else url
                    if not local(url):
                        self.external.append((tag, name, url.strip()))
            if name == "style":
                self.css.append(value)
            if name.startswith("on"):
                self.script.append(value)

        block = a.get("data-vista-bloco", "").strip()
        if block:
            self.blocks.add(block)
            if block == "prova" and self.open_cards:
                card = self.cards[self.open_cards[-1]]
                card["provas"].append(a.get("href", "").strip())

        if "data-vista-card" not in a:
            return False
        self.cards.append({
            "id": a.get("data-vista-card", "").strip() or f"#{len(self.cards) + 1}",
            "desfecho": a.get("data-vista-desfecho", "").strip(),
            "risco": a.get("data-vista-risco", "").strip(),
            "provas": [],
            # the depth OUTSIDE the card: this runs before the tag is pushed
            "depth": len(self.stack),
        })
        return True


def check(path):
    """Return the list of failures for one file — empty means it qualifies."""
    with open(path, encoding="utf-8-sig") as f:
        text = f.read()
    v = Vista()
    v.feed(text)
    v.close()
    bad = []

    # -- self-contained ----------------------------------------------------
    for tag, attr, url in v.external:
        bad.append(f"external resource: <{tag} {attr}=\"{url}\"> — must be data: or #fragment")
    css = "\n".join(v.css)
    if CSS_IMPORT.search(css):
        bad.append("external resource: @import — a vista inlines its CSS instead")
    for _, url in CSS_URL.findall(css):
        if not local(url):
            bad.append(f"external resource: CSS url({url}) — must be data: or #fragment")
    for call in sorted({m.group(0).strip() for m in NETWORK_CALLS.finditer("\n".join(v.script))}):
        bad.append(f"network call in script: {call} — a vista renders from what it already holds")

    # -- the five blocks ---------------------------------------------------
    for marker in PAGE_BLOCKS:
        number, name = BLOCKS[marker]
        if marker not in v.blocks:
            bad.append(f'block {number} missing: no data-vista-bloco="{marker}" ({name})')
    if not v.cards:
        bad.append("block 2 missing: no data-vista-card in the page")
    for card in v.cards:
        if not card["desfecho"]:
            bad.append(f'block 2: card {card["id"]} has no data-vista-desfecho '
                       "(cards group by outcome)")
        if not card["risco"]:
            bad.append(f'block 3: card {card["id"]} has no data-vista-risco (risk tag per card)')
        if not [u for u in card["provas"] if u]:
            number, name = BLOCKS[CARD_BLOCK]
            bad.append(f'block {number}: card {card["id"]} carries no '
                       f'data-vista-bloco="prova" link with an href ({name})')
    for text_out in v.loose if v.declared_structure else []:
        bad.append(f"text printed outside <body>: {text_out!r} — the usual cause is a "
                   "comment holding a nested comment, which ends at the first -->")

    # -- readable in both themes -------------------------------------------
    if not DARK_THEME.search(css):
        bad.append("no prefers-color-scheme: dark rule — the page has one theme, "
                   "and the reader may be in the other")
    return bad


def main(argv=None):
    p = argparse.ArgumentParser(
        prog="tk-vista-check",
        description="Checks an outbox vista: self-contained, and the five blocks of the "
                    "contract in ../reference/vista.md.")
    p.add_argument("files", nargs="+", metavar="FILE.html")
    args = p.parse_args(argv)

    failed = False
    for path in args.files:
        if not os.path.isfile(path):
            print(f"{path}: not a regular file", file=sys.stderr)
            return 2
        try:
            bad = check(path)
        except (OSError, UnicodeDecodeError) as e:
            print(f"{path}: unreadable — {e}", file=sys.stderr)
            return 2
        if bad:
            failed = True
            print(f"FAIL {path}")
            for b in bad:
                print(f"  - {b}")
        else:
            print(f"ok   {path}")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
