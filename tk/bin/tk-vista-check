#!/usr/bin/env python3
"""tk-vista-check — does this HTML file qualify as a *vista*?

A vista is the visual companion of a package digest: a page the human READS to
give a verdict, written to the outbox and thrown away. It is never a source, so
nothing is read back from it.

WHAT THIS GATE MEASURES — and nothing beyond it, because a gate that announces
more than it measures is worse than one that measures less:

1. The page fetches NOTHING. Every URL the browser would resolve to render it is
   `data:` or a `#` fragment, and the page carries no script at all.
2. The five blocks of the contract are present, by marker.
3. Each card names an outcome from the closed vocabulary, carries a risk tag,
   and links a proof that is not still a placeholder.
4. The page answers the dark colour scheme.

WHAT IT DOES NOT MEASURE, in the same four items `../reference/vista.md` lists
to the human side, so no report can borrow authority this gate lacks:

- LEGIBILITY. It sees that the page answers the dark scheme, never that either
  palette is readable — that is measured by RENDERING the file.
- BLOCK 1's CONTENT. A `stats` marker around an empty list passes; what is in a
  block is the writer's, and so is whether the prose is worth reading.
- WHERE A LINK LEADS. `<a href>` is exempt by design, and only the placeholder
  rule touches it: a link to the wrong PR is a green page.
- ONE WAY. That nothing is read back from a vista is a rule of the flow, held by
  prose and by no mechanism here.

NO SCRIPT, rather than a list of forbidden calls. A blocklist of network calls
loses to `new Image()`, to `window["fet"+"ch"]`, to a name bound before it is
used — measured, each on a page that was otherwise green. A vista needs no
script: its collapsibles are `<details>`, its themes are a media query, its
drawings are inline SVG. So the property checked is the one that matters — this
page runs nothing — and it cannot be spelled around.

LINKS STAY. A vista MUST carry links: block 4 of the contract is the link to the
proof, which lives in the PR. The line is what the browser FETCHES versus where
the reader CLICKS — `<a href>` may point anywhere real, and everything else must
already be inside the file. A RELATIVE path is refused by the same rule and
deliberately: `src="logo.png"` costs no network but breaks the moment the file
is copied anywhere alone, which is the normal life of an outbox file.

Usage:  tk-vista-check <file.html> [<file.html> ...]
Exit:   0 every file qualifies · 1 some file does not · 2 bad usage/unreadable
"""

import argparse
import os
import re
import sys
from html.parser import HTMLParser
from urllib.parse import urlparse

# Attributes whose value the browser FETCHES. `href` is here too, and the `<a>`
# exemption is applied where the tag is known — not by dropping href from the
# list, which would also exempt <link rel=stylesheet>
URL_ATTRS = {
    "src", "srcset", "poster", "data", "href", "action", "formaction",
    "background", "cite", "longdesc", "manifest", "xlink:href", "codebase",
}

# Marker -> the block's number and the name a refusal prints. The page-level
# blocks are DERIVED from this table, so a marker added to one cannot be
# forgotten in the other
BLOCKS = {
    "stats": (1, "the opening stats line"),
    "cards": (2, "the cards region"),
    "prova": (4, "the slice's proof"),
    "saldo": (5, "closed × open balance"),
}
CARD_BLOCK = "prova"                       # the one checked card by card
PAGE_BLOCKS = tuple(m for m in BLOCKS if m != CARD_BLOCK)

# The closed vocabulary of outcomes. One list, here, because the CSS that
# colours a card and the report that groups them have to agree, and a value
# outside it renders as an uncoloured card nobody notices
OUTCOMES = ("merged", "closed", "open", "carried", "blocked", "discarded")

# A proof link that still points at a placeholder is not a proof. These names
# are reserved by RFC 2606 and RFC 6761 to never resolve to anything real, so a
# link to one can never be evidence — the test is "never resolves", not "looks
# fake", because the gate cannot tell a real link from a plausible one
PLACEHOLDER_HOSTS = ("localhost", "invalid", "test", "example", "local",
                     "example.com", "example.org", "example.net")

# Every CSS function that takes a URL, not `url()` alone: `image-set()` fetches
# just as hard, and a checker that knows one token is a checker that fetches the
# other one
CSS_URL_FUNC = re.compile(r"(?<![\w-])(url|image-set|-webkit-image-set)\s*\(", re.IGNORECASE)
CSS_IMPORT = re.compile(r"@import\b", re.IGNORECASE)
DARK_THEME = re.compile(r"prefers-color-scheme\s*:\s*dark", re.IGNORECASE)

VOID = {"area", "base", "br", "col", "embed", "hr", "img", "input", "link",
        "meta", "param", "source", "track", "wbr"}


# WHATWG URL: tab, CR and LF are removed from the WHOLE string before parsing,
# and leading/trailing C0-or-space is stripped. Every comparison below runs on
# the normalised value — measured: `java<TAB>script:alert(1)` in an <a href>
# EXECUTES in Chromium, and `.strip()` alone leaves the tab in the middle
URL_JUNK = re.compile(r"[\t\n\r]")
C0_OR_SPACE = "".join(chr(c) for c in range(0x21))
SCRIPT_SCHEMES = ("javascript:", "vbscript:")


def normalise(url):
    """The URL as the browser will read it, not as the file spells it."""
    return URL_JUNK.sub("", url or "").strip(C0_OR_SPACE)


def script_url(url):
    """True when following this URL runs code rather than fetching a document."""
    return normalise(url).lower().startswith(SCRIPT_SCHEMES)


def local(url):
    """True when the browser can resolve `url` without leaving this file."""
    u = normalise(url)
    if u.startswith("#"):
        return True
    # everything else has to be inline. An EMPTY value falls through to False on
    # purpose: `src=""` is not "no URL", it resolves to the page and refetches it
    return u.lower().startswith("data:")


def placeholder(url):
    """The reason this href is not yet a proof, or None when it is one."""
    u = normalise(url)
    if not u or u.startswith("#"):
        return "it points nowhere"
    if "FILL" in u:
        return "it still carries a FILL marker"
    # the trailing dot of a fully qualified name resolves the same and must not
    # buy a way past the comparison
    host = (urlparse(u).hostname or "").lower().rstrip(".")
    for bad in PLACEHOLDER_HOSTS:
        if host == bad or host.endswith("." + bad):
            return f"{host} is a reserved placeholder name"
    return None


def balanced(css, opening):
    """The text between the paren at `opening` and the one that closes it.

    A regex cannot do this: `[^)]*` truncates `image-set(url(data:…) 1x)` at the
    INNER paren, and the mutilated token then fails the `data:` test — a local,
    legitimate page refused. Quotes are honoured so a paren inside a string does
    not close anything."""
    depth, quote, i = 0, None, opening
    while i < len(css):
        ch = css[i]
        if quote:
            if ch == quote:
                quote = None
        elif ch in "\"'":
            quote = ch
        elif ch == "(":
            depth += 1
        elif ch == ")":
            depth -= 1
            if depth == 0:
                return css[opening + 1:i]
        i += 1
    return css[opening + 1:]        # unbalanced: judge what there is


def top_level_commas(text):
    """`text` split on the commas that are not inside parens or quotes."""
    parts, depth, quote, start = [], 0, None, 0
    for i, ch in enumerate(text):
        if quote:
            if ch == quote:
                quote = None
        elif ch in "\"'":
            quote = ch
        elif ch == "(":
            depth += 1
        elif ch == ")":
            depth -= 1
        elif ch == "," and depth == 0:
            parts.append(text[start:i])
            start = i + 1
    parts.append(text[start:])
    return parts


def css_urls(css):
    """Every URL the stylesheet would fetch, from every function that takes one."""
    found, pos = [], 0
    while True:
        m = CSS_URL_FUNC.search(css, pos)
        if not m:
            return found
        # resume just INSIDE this function, so a nested `url()` is found by its
        # own pass rather than read as a token of the outer one
        pos = m.end()
        content = balanced(css, m.end() - 1)
        if m.group(1).lower() == "url":
            token = content.strip().strip("'\"")
            if token:
                found.append(token)
            continue
        for candidate in top_level_commas(content):
            candidate = candidate.strip()
            # `image-set("a.png" 1x)` — the descriptor is not part of the URL
            if not candidate or CSS_URL_FUNC.match(candidate):
                continue
            token = candidate.split()[0].strip("'\"")
            if token:
                found.append(token)


class Vista(HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.loose = []          # text printed outside the structure the page declared
        # `<html>` and `<body>` are optional in HTML5: a page that declares
        # neither keeps its text at depth zero legitimately, and refusing that
        # would refuse the free layout the contract promises
        self.declared_structure = False
        self.stack = []          # open tags, innermost last
        self.cards = []          # one dict per card found
        self.open_cards = []     # indices into self.cards, innermost last
        self.blocks = set()      # data-vista-bloco values seen anywhere
        self.css = []            # every stylesheet-ish string in the document
        self.external = []       # (tag, attr, value)
        self.scripts = []        # every way the page would run code
        self.refreshes = []      # <meta http-equiv=refresh> targets

    def in_style(self):
        return bool(self.stack) and self.stack[-1] == "style"

    # -- traversal ---------------------------------------------------------
    def handle_starttag(self, tag, attrs):
        opened_card = self._element(tag, attrs)
        if tag not in VOID:
            self.stack.append(tag)
            if opened_card:
                self.open_cards.append(len(self.cards) - 1)

    def handle_startendtag(self, tag, attrs):
        # `<article data-vista-card/>` closes where it opens: it is a card, and
        # it never becomes the container a later prova link is counted into
        self._element(tag, attrs)

    def handle_endtag(self, tag):
        if tag in self.stack:
            # pop through the tags an unclosed <p> or <li> left behind, so one
            # sloppy element cannot detach every card boundary below it
            while self.stack:
                open_tag = self.stack.pop()
                depth = len(self.stack)
                while self.open_cards and self.cards[self.open_cards[-1]]["depth"] >= depth:
                    self.open_cards.pop()
                if open_tag == tag:
                    break

    def handle_data(self, data):
        if self.in_style():
            self.css.append(data)
        elif not self.stack and data.strip():
            self.loose.append(" ".join(data.split())[:60])

    # -- one element -------------------------------------------------------
    def _element(self, tag, attrs):
        """Read one element; True when it opened a card."""
        a = {k.lower(): (v or "") for k, v in attrs}
        if tag in ("html", "body"):
            self.declared_structure = True
        if tag == "script":
            self.scripts.append("<script>")
        if tag == "meta" and a.get("http-equiv", "").strip().lower() == "refresh":
            self.refreshes.append(a.get("content", "").strip())

        for name, value in a.items():
            if name.startswith("on"):
                self.scripts.append(f"{name}=")
            if name in URL_ATTRS:
                if script_url(value):
                    scheme = normalise(value).lower().split(":", 1)[0]
                    self.scripts.append(f"<{tag} {name}={scheme}:>")
                    continue
                if tag == "a" and name == "href":
                    continue        # a link the human clicks loads nothing now
                for url in (value.split(",") if name == "srcset" else [value]):
                    url = url.strip().split(" ")[0] if name == "srcset" else url
                    if not local(url):
                        self.external.append((tag, name, url.strip()))
            if name == "style":
                self.css.append(value)

        block = a.get("data-vista-bloco", "").strip()
        if block:
            self.blocks.add(block)
            if block == CARD_BLOCK and self.open_cards:
                self.cards[self.open_cards[-1]]["provas"].append(a.get("href", "").strip())

        if "data-vista-card" not in a:
            return False
        self.cards.append({
            "id": a.get("data-vista-card", "").strip() or f"#{len(self.cards) + 1}",
            "desfecho": a.get("data-vista-desfecho", "").strip(),
            "risco": a.get("data-vista-risco", "").strip(),
            "provas": [],
            # the depth OUTSIDE the card: this runs before the tag is pushed
            "depth": len(self.stack),
        })
        return True


def check(path):
    """Return the list of failures for one file — empty means it qualifies."""
    with open(path, encoding="utf-8-sig") as f:
        text = f.read()
    v = Vista()
    v.feed(text)
    v.close()
    bad = []

    # -- fetches nothing ---------------------------------------------------
    for tag, attr, url in v.external:
        bad.append(f"external resource: <{tag} {attr}=\"{url}\"> — must be data: or #fragment")
    for how in sorted(set(v.scripts)):
        bad.append(f"the page runs code ({how}) — a vista carries no script: its collapsibles "
                   "are <details>, its themes a media query, its drawings inline SVG")
    for target in v.refreshes:
        bad.append(f"<meta http-equiv=\"refresh\" content=\"{target}\"> — the page navigates "
                   "on its own")
    css = "\n".join(v.css)
    if CSS_IMPORT.search(css):
        bad.append("external resource: @import — a vista inlines its CSS instead")
    for url in css_urls(css):
        if not local(url):
            bad.append(f"external resource: CSS fetches {url} — must be data: or #fragment")

    # -- the five blocks ---------------------------------------------------
    for marker in PAGE_BLOCKS:
        number, name = BLOCKS[marker]
        if marker not in v.blocks:
            bad.append(f'block {number} missing: no data-vista-bloco="{marker}" ({name})')
    if not v.cards:
        bad.append("block 2 missing: no data-vista-card in the page")
    for card in v.cards:
        if not card["desfecho"]:
            bad.append(f'block 2: card {card["id"]} has no data-vista-desfecho '
                       "(cards group by outcome)")
        elif card["desfecho"] not in OUTCOMES:
            bad.append(f'block 2: card {card["id"]} has outcome "{card["desfecho"]}", which is '
                       f"outside the vocabulary ({', '.join(OUTCOMES)}) — the CSS that colours a "
                       "card knows only these")
        if not card["risco"]:
            bad.append(f'block 3: card {card["id"]} has no data-vista-risco (risk tag per card)')
        number, name = BLOCKS[CARD_BLOCK]
        if not card["provas"]:
            bad.append(f'block {number}: card {card["id"]} carries no '
                       f'data-vista-bloco="prova" link ({name})')
        else:
            why = [placeholder(u) for u in card["provas"]]
            if why and all(why):
                bad.append(f'block {number}: card {card["id"]} links no real proof — '
                           f"{why[0]}")
    for text_out in v.loose if v.declared_structure else []:
        bad.append(f"text printed outside <body>: {text_out!r} — the usual cause is a "
                   "comment holding a nested comment, which ends at the first -->")

    # -- answers the dark scheme -------------------------------------------
    if not DARK_THEME.search(css):
        bad.append("no prefers-color-scheme: dark rule — the page answers one scheme, and the "
                   "reader may be in the other. Whether both are LEGIBLE is measured by "
                   "rendering the file, not here")
    return bad


def main(argv=None):
    p = argparse.ArgumentParser(
        prog="tk-vista-check",
        description="Checks an outbox vista: fetches nothing, runs nothing, carries the five "
                    "blocks of ../reference/vista.md, and answers the dark scheme.")
    p.add_argument("files", nargs="+", metavar="FILE.html")
    args = p.parse_args(argv)

    failed = False
    for path in args.files:
        if not os.path.isfile(path):
            print(f"{path}: not a regular file", file=sys.stderr)
            return 2
        try:
            bad = check(path)
        except (OSError, UnicodeDecodeError) as e:
            print(f"{path}: unreadable — {e}", file=sys.stderr)
            return 2
        if bad:
            failed = True
            print(f"FAIL {path}")
            for b in bad:
                print(f"  - {b}")
        else:
            print(f"ok   {path}")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
