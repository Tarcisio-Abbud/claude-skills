#!/usr/bin/env python3
"""tk-compact-mark — the `PreCompact` hook: one ledger line per orchestrator compaction.

WHY IT EXISTS: on the night of 2026-09-06 an orchestrator's context filled, the
`/compact` armed for it never ran, and nothing in the package's ledger said so.
A generation later, reading the ledger, there was no way to tell a compaction
that happened from one that did not. This hook is the trace. It blocks nothing
and asks nothing: it appends one line to the package's ledger in the format
`../skills/kickoff/LEDGER.md` fixes, and exits 0. The veto of a subagent's
compaction is not here: it is the tk mod, `../hooks/compact-veto.js`.

WHERE THE LEDGER IS. Not here, and not in the wiring. The ledger is one file per
package, in that package's own outbox, so the address is volatile and the
wiring in `~/.claude/settings.json` is not: the orchestrator writes the package
pointer at `~/.claude/state/tk-package.json` when the package opens, and both
compaction hooks read it. **No pointer file, no line and no noise** — that is
what lets the wiring sit in the settings permanently while most sessions are not
packages at all. The pointer is one file per machine, so it also names the
orchestrator's `session`, and a compaction of any other session writes nothing:
the ledger is that one session's.

WHY IT NEVER FAILS LOUDLY: a hook that errors is a hook that interrupts every
session on this machine, and what is at stake here is one line of a log. Every
failure path exits 0 with a word on stderr, which Claude Code discards for a
hook that exits 0 — that is the correct volume for this.

THE HOUR IS READ, never counted: `LEDGER.md` requires it, because four lines of
the package this format comes from were written from a model's sense of elapsed
time and were an hour wrong. A clock read by a script is the same read `date`
gives, and it is the only kind of hour this file writes.

THE QUOTA FIELD IS THE BIN'S OWN LINE. `LEDGER.md` refuses a bare percentage in
that field, so the line pasted here is whatever `tk-quota` printed, and where it
can vouch for nothing the field says that instead of a number.

WHOSE COMPACTION IT IS. A subagent filling its window is not a seam of the
package: the orchestrator keeps its context, and a line saying otherwise reads
as the package having been emptied. On 2026-09-19 four such lines landed in one
ledger while the orchestrator's transcript held no `compact_boundary` at all.
This hook cannot tell the two apart: a subagent's payload carries the
orchestrator's `session_id`, `transcript_path` and `cwd`, and no `agent_id`
(measured on 2.1.286 and again on 2.1.287), although the harness documents that
field as present from within a subagent. The `agent_id` test below is kept for a
binary that sends it, and today it is inert. What keeps a subagent's line out is
the mod: on 2.1.287 and later it vetoes a package subagent's compaction before
the engine runs the settings hooks, so this hook never fires for it (measured).
It vetoes only under a numeric window, so the line names that judgement: under
`auto`, or on an older binary, a subagent's compaction still lands here, and the
line says the window let it. `agent_type` is NOT the field to ask: it arrives on
the main thread of any session started with `--agent`.

Stdin:  the hook's JSON payload (`trigger`, `session_id`, `agent_id`, …). A
        payload that is not readable costs the line its trigger, never the line.
Usage:  tk-compact-mark [--file PATH]
Exit:   0, always.
"""

import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
POINTER = "~/.claude/state/tk-package.json"
QUOTA = os.path.join(HERE, "tk-quota")
QUOTA_TIMEOUT = 10                    # a hook waits for nothing longer than this

# The ledger's own field separator, and the two literals `LEDGER.md` defines for
# an event no lane owns.
SEPARATOR = " | "
SYSTEM_LANE = "(sistema)"
EMPTY = "-"


def plain(value):
    """A value from outside this process, safe in a pipe-separated line.

    Two things arrive from elsewhere: the trigger, from the harness, and the
    package name, from a file. A pipe in either would add a field to a line
    whose readers count fields, and a control character would reprogram the
    terminal of whoever reads the ledger.
    """
    return re.sub(r"[\x00-\x1f\x7f|]", "?", str(value)).strip()


def pointer(path):
    """The package pointer, or None when no package is running.

    None is the ordinary case: most sessions on this machine are not packages,
    and the wiring is the same for all of them.
    """
    if not os.path.isfile(path):
        return None
    try:
        with open(path, encoding="utf-8-sig") as handle:
            found = json.load(handle)
    except (OSError, ValueError, UnicodeDecodeError) as exc:
        print(f"tk-compact-mark: cannot read {path}: {exc}", file=sys.stderr)
        return None
    return found if isinstance(found, dict) else None


def quota_field():
    """What `tk-quota` printed, or why it could not print anything.

    Never a number this script composed: `LEDGER.md` refuses a bare percentage
    in this field precisely because nothing downstream can then tell a reading
    from an estimate.
    """
    try:
        run = subprocess.run([sys.executable, QUOTA], capture_output=True,
                             text=True, timeout=QUOTA_TIMEOUT)
    except (OSError, subprocess.SubprocessError) as exc:
        return f"no reading ({plain(exc)})"
    line = run.stdout.strip().splitlines()
    if run.returncode != 0 or not line:
        return f"no reading (tk-quota exit {run.returncode})"
    return plain(line[0])


def from_subagent(payload):
    """Whether the payload itself says this compaction is a subagent's.

    Inert on 2.1.286 and 2.1.287 (module docstring, "WHOSE COMPACTION IT IS"),
    kept for a binary that sends the field. A blank or non-string value is read
    as absence, since what the field asserts is a subagent's identity and
    neither is one.
    """
    agent = payload.get("agent_id")
    return isinstance(agent, str) and agent.strip() != ""


def other_session(package, payload):
    """Whether the pointer names the orchestrator's session and this payload is
    another one's. A pointer that names none (written before the field) gates
    nothing, as before it existed."""
    owner = package.get("session")
    if not isinstance(owner, str) or not owner.strip():
        return False
    return payload.get("session_id") != owner


def load(name):
    """A sibling bin as a module. Loaded, never copied: a second reader of the
    window is a fork."""
    path = os.path.join(HERE, name)
    loader = importlib.machinery.SourceFileLoader(name.replace("-", "_"), path)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def judgement(payload):
    """Whether the mod could have kept a subagent's compaction out of this line.

    The window is the SESSION's, read from the directory its transcript opened
    in, as `tk-context --window` reads it. Where that directory is unknown, the
    hook's own directory stands in, and the words say so. A failure to read it
    costs the words, never the line. The model window is not in the payload, so
    the words name the mod's second condition instead of judging it.
    """
    try:
        context = load("tk-context")
        path = payload.get("transcript_path")
        base = context.session_dir(path) if isinstance(path, str) else None
        fell_back = not base
        if fell_back:
            base = payload.get("cwd") or os.getcwd()
        found = context.numeric_window(base)
    except (Exception, SystemExit) as exc:    # a hook that raises interrupts the session
        return f"window unread ({plain(type(exc).__name__)})"
    where = ", read from the hook's directory" if fell_back else ""
    if found is None:
        return (f"window not numeric{where}, so the tk mod vetoes nothing "
                "and a subagent's lands here too")
    return (f"window {found[0]}{where}, so the tk mod vetoes a subagent's on Claude Code "
            "2.1.287+ when the model window is larger")


def event_line(payload):
    """The seven fields of `LEDGER.md`'s event line, in its order. The sixth
    names the session (8 characters) and the judgement."""
    trigger = plain(payload.get("trigger") or "unknown")
    session = plain(payload.get("session_id") or "unknown")[:8]
    return SEPARATOR.join([
        time.strftime("%H:%M"),
        SYSTEM_LANE,
        EMPTY,
        EMPTY,
        f"harness auto-compact ({trigger})",
        plain(f"context emptied (session {session}: {judgement(payload)}); "
              "the SessionStart hook points the successor at the handoff"),
        quota_field(),
    ])


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    path = os.path.expanduser(POINTER)
    if argv[:1] == ["--file"] and len(argv) > 1:
        path = argv[1]

    try:
        payload = json.load(sys.stdin)
    except (ValueError, OSError):
        payload = {}
    if not isinstance(payload, dict):
        payload = {}

    if from_subagent(payload):
        # A subagent compacted, not the session this ledger belongs to. The
        # reason is not the one below — a package IS running here — it is that
        # the package's own context survived, so the line would be a false seam.
        return 0

    package = pointer(path)
    ledger = (package or {}).get("ledger")
    if not ledger:
        # No package is running, or the pointer names no ledger. Silence is the
        # answer: this hook is wired for every session on the machine.
        return 0
    if other_session(package, payload):
        # A package is running, in another session: its ledger is not this one's.
        return 0

    address = os.path.expanduser(str(ledger))
    if os.path.exists(address) and not os.path.isfile(address):
        # Guarding the parse is not guarding the OPEN. A directory raises; a FIFO
        # does not — it BLOCKS, and a PreCompact hook that blocks stops the
        # session with nothing on screen. The address comes from a file outside
        # this bin's control, so it is confirmed to be a regular file first. A
        # ledger nobody has created yet is legitimate and opens normally.
        print(f"tk-compact-mark: {ledger} is not a regular file", file=sys.stderr)
        return 0
    try:
        with open(address, "a", encoding="utf-8") as handle:
            handle.write(event_line(payload) + "\n")
    except OSError as exc:
        print(f"tk-compact-mark: cannot append to {ledger}: {exc}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
