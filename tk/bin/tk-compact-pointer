#!/usr/bin/env python3
"""tk-compact-pointer — the `SessionStart` hook, matcher `compact`: where to resume.

WHY IT EXISTS: this is the piece that was missing on 2026-09-06. An
auto-compacted orchestrator wakes holding a machine summary of its own context
and no instruction — it does not know that a handoff was written for it, and the
summary is the one document that never says so. A `SessionStart` hook can INJECT
text into the session's context, which makes it the one channel that reaches a
model nobody is talking to. So what it prints is an instruction: read the
handoff, resume by `RESUME.md`, and the ledger is here.

THE INJECTION IS THE JSON ENVELOPE, NOT PLAIN STDOUT. Measured 2026-09-09 on
2.1.266, first the wrong way: a hook printing a plain paragraph ran, and the
session it ran for could not find a word of it. The binary's own reader says why
— a hook that exits 0 with no JSON payload and nothing on stderr is logged as
"produced no response payload" and its attachment is skipped. What reaches the
context is `hookSpecificOutput.additionalContext`, under the matching
`hookEventName`, so that is what this prints.

IT DOES NOTHING ELSE. It does not resume anything, does not read the queue and
does not run a skill; `../skills/kickoff/RESUME.md` owns the procedure and this
hook only names it.

WHERE THE ADDRESSES COME FROM: the package pointer at
`~/.claude/state/tk-package.json`, written by the orchestrator when the package
opens. **No pointer file, nothing printed.** Most compacted sessions on this
machine are not packages, and injecting a package's instruction into one of them
is worse than saying nothing. The pointer is one file per machine, so it names
the orchestrator's `session` too, and a session it does not name hears nothing
(measured 2026-10-01: without the gate, a subagent of an unrelated session was
told a package was running).

`RESUME.md` IS RESOLVED FROM THIS FILE, not from the pointer. The skill travels
with the bin, so the path is known here and a pointer that named it could go
stale against a plugin that moved.

A SUBAGENT HEARS IT TOO, SO IT IS WRITTEN TO BE HARMLESS THERE. This hook fires
inside a subagent that compacts, measured on 2026-09-19 in an implementer's own
transcript: it was told it had been orchestrating the package and must read the
orchestrator's handoff "before anything else", which is an instruction to drop
the item it was holding. The harness documents `agent_id` as set only from
within a subagent, and with it present nothing is printed; on 2.1.286 and
2.1.287 that test is inert, because a subagent's compaction payloads carry no
`agent_id` (measured 2026-10-01). tk's mod (`../hooks/compact-veto.js`) vetoes a
package subagent's compaction on 2.1.287 and later, under a numeric window; the
one it lets through (an older binary, a window that is not a number) wakes here
looking like the orchestrator's. So the paragraph opens with the EXCLUSION: an
agent the summary shows was dispatched with a brief or an item continues it and
reads no handoff.
Only then does it address the orchestrator. `agent_type` is not the field to
ask: it also arrives on the main thread of a session started with `--agent`,
the very session this hook exists for.

Stdin:  the hook's JSON payload. `source` other than `compact` prints nothing, an
        absent or unreadable one included — the matcher in the wiring already
        selects, and this is the second guard for a wiring widened by hand. A
        payload carrying `agent_id` prints nothing either.
Usage:  tk-compact-pointer [--file PATH]
Exit:   0, always. A hook that fails interrupts a session; what is at stake here
        is one paragraph.
"""

import json
import os
import re
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
POINTER = "~/.claude/state/tk-package.json"
RESUME = os.path.normpath(os.path.join(HERE, os.pardir, "skills", "kickoff", "RESUME.md"))
SOURCE = "compact"
EVENT = "SessionStart"


def plain(value):
    """A value read from a file, safe to inject into a context and a terminal."""
    return re.sub(r"[\x00-\x1f\x7f]", "?", str(value)).strip()


def pointer(path):
    """The package pointer, or None when no package is running."""
    if not os.path.isfile(path):
        return None
    try:
        with open(path, encoding="utf-8-sig") as handle:
            found = json.load(handle)
    except (OSError, ValueError, UnicodeDecodeError) as exc:
        print(f"tk-compact-pointer: cannot read {path}: {exc}", file=sys.stderr)
        return None
    return found if isinstance(found, dict) else None


def from_subagent(payload):
    """Whether the payload itself says this wake is a subagent's.

    Inert on 2.1.286 and 2.1.287 (module docstring), kept for a binary that
    sends the field; the exclusion that opens the paragraph is what protects a
    subagent today. A blank or non-string value is read as absence, since
    neither is a subagent's identity.
    """
    agent = payload.get("agent_id")
    return isinstance(agent, str) and agent.strip() != ""


def lines(package):
    """What the compacted session is told, or nothing at all.

    The exclusion comes first, so a subagent stops reading at the sentence that
    tells it to keep its item. The handoff is asked for on disk: a pointer at a
    briefing nobody wrote is worse than silence — the session would go looking
    and find a summary of its own context instead — so that case says what is
    wrong rather than where to read.
    """
    handoff = package.get("handoff")
    if not handoff:
        return []
    handoff = os.path.expanduser(plain(handoff))
    name = plain(package.get("package") or "this package")
    said = [f"tk: a compaction happened while package {name} was running.",
            "If the summary above shows you were dispatched with a brief or an item, "
            "this paragraph is not for you: continue your item and do not read the "
            "handoff."]
    if os.path.isfile(handoff):
        said.append(f"If you were orchestrating {name}: read the handoff at {handoff} "
                    f"before anything else, then resume by {RESUME}.")
    else:
        said.append(f"If you were orchestrating {name}: the package pointer names a "
                    f"handoff at {handoff} and there is no file there. Do not "
                    f"reconstruct it from the summary above: read {RESUME}, and "
                    f"rebuild the state from git and the ledger.")
    ledger = package.get("ledger")
    if ledger:
        said.append(f"The package ledger is {os.path.expanduser(plain(ledger))}; its last "
                    f"lines say what was running when the window filled.")
    return said


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    path = os.path.expanduser(POINTER)
    if argv[:1] == ["--file"] and len(argv) > 1:
        path = argv[1]

    try:
        payload = json.load(sys.stdin)
    except (ValueError, OSError):
        payload = {}
    if not isinstance(payload, dict):
        payload = {}
    if payload.get("source") != SOURCE:
        # An absent key is not a compact either: the `{}` above stands in for a
        # payload nobody could read, and injecting a package's instruction into
        # an unidentified session is worse than saying nothing.
        return 0
    if from_subagent(payload):
        # A subagent compacted, not the session the package belongs to. Telling
        # it to read the orchestrator's handoff before anything else is telling
        # it to abandon its own item.
        return 0

    package = pointer(path)
    if not package:
        return 0
    owner = package.get("session")
    if isinstance(owner, str) and owner.strip() and payload.get("session_id") != owner:
        # A package is running, in another session: its handoff is not this one's.
        return 0
    said = lines(package)
    if said:
        print(json.dumps({"hookSpecificOutput": {
            "hookEventName": EVENT, "additionalContext": " ".join(said)}}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
