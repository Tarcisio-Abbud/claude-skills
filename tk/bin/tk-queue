#!/usr/bin/env python3
"""tk-queue — deterministic gate for a project's pending-items queue.

The ONLY writer of the two auto-memory queue files:

  next-steps.md   open items only (the queue /tk:kickoff dispatches)
  done-log.md     what left the queue, when, and how (feeds progress reports)

An item leaves next-steps.md the moment it is resolved or discarded — `done`
and `cancel` move it to done-log.md in one command, log written first: a crash
between the two writes can leave the item in both files (rerun-visible), never
lost. That is what keeps finished work from silently accumulating in the queue.

Items are identified by sequential IDs (**T001**, **T002**, ...) unique within
a project (both files scanned, at the positions where a WRITER puts an ID, so
a closed item's ID is never reused and an ID merely quoted in prose is not
mistaken for an allocated one). Two tolerances at that position, both one-way —
they can only make MORE IDs count as taken, never fewer: DECORATION between the
box and the ID is read through (`- [x] ✅ **T020**`, `~~**T012**~~`,
`**~~T012~~**` — a word is not decoration, so prose still allocates nothing),
and the CHECKBOX is not read at all, so an ID parked in done-log.md under an
open box is spent all the same. Open items predating this script may lack IDs;
`migrate` assigns them (legacy [x]
items move to the log verbatim, ID-less, and — carrying no `- YYYY-MM-DD —`
prefix — stay outside `report`'s scope; read the log itself for that history).

Priority is the file's ORDER, global — no score, no hidden heuristic. `add` puts a
new item at the end and `bump` moves one to the top; the package modes take the
filtered top.

The DECISION class parks the queue until the user is back, so it is never reached
by omission: `add --class DECISION` and any `edit` that sets that class demand
`--deferred <justification>`, which lands in the item as a **Deferred:** field.
The default path is the other one — ask the decision at birth, write it into the
item's text and Criterion, and the item is AUTONOMOUS.

WHERE an item runs is a field of its own, orthogonal to the class: **Env:**
names an environment from the site file's roster (`~/.claude/tk/env`, read by
tk_site.py beside this script), and its ABSENCE means the machine that owns the
queue. The value is validated by exact equality against that roster, and refused
when it is not in it — an environment nothing validated is a phantom one, an
item no machine ever picks up with no error to say why. No roster, no `--env`:
the flag is refused with the file to create, because the plugin ships no
machine's name of its own.

WHO is working on it is a third field, and the only one this script writes on
its own: `claim <id> --as <name>` marks the item under the queue's exclusive
lock, and a second `claim` is REFUSED naming the owner and the moment — that is
how two sibling sessions on one queue stop executing the same item (collisions
measured 2026-08-18). The mark leaves with the item on `done`/`cancel`, and
`release <id>` hands it back to the queue without closing it. It is deliberately
NOT an `edit` flag: `edit --claimed <other>` would take a held item in a second
command, which is precisely what `claim` refuses in one.

Size ceilings: an item is a PENDING ACTION, not an essay. Durable context
belongs in a memory file or the wiki, linked from the item. TWO ceilings, and
which one a flag answers to depends on the flag's NATURE:

  block (CEILING)   the whole item. `add` always. `edit` whenever a PROSE flag
                    is used (--text, --criterion, --risk, --deferred) and the edit
                    grows the item. Exempt: the short fields below — that exemption is
                    what keeps a legacy oversized item taggable without --force.
  field             each field VALUE, on add, edit and the closes alike.
                    FIELD_CEILING_SHORT for --class/--effort/--project, which
                    are bounded by construction (enum, "M (~30min)", a slug);
                    FIELD_CEILING for prose.

Neither ceiling holds alone: with only the block one, a single field edit was
exempt and reached 1014 chars; with only the field one, three prose fields in a
single call reached 709 past a 700 ceiling. --force raises both.

Every mutating command prints the resolved memory dir on stderr before acting:
the target queue is inferred from --dir or the cwd, and an unseen inference is
an unchecked one.
"""

import argparse
import contextlib
import datetime
import os
import re
import sys
import tempfile
import time

try:
    import fcntl
except ImportError:      # non-POSIX; see queue_lock
    fcntl = None

# the site file's reader, beside this script. Inserted explicitly rather than
# relied on: sys.path[0] is the script's directory only when Python launched
# THIS file, and the suite also loads it as a module
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import tk_site      # noqa: E402  (the path above is what makes it importable)

CLASSES = ("AUTONOMOUS", "DECISION", "BLOCKED", "EXTERNAL", "RECURRING")
# The class that PARKS the queue: nothing moves on a DECISION item until the user
# is back. So it may not be reached by omission — `add --class DECISION` and any
# `edit` that sets that class demand `--deferred <justification>`, recorded in the
# item as a field. The default path is the other one: ask the decision at birth and
# write it into the item's text and Criterion, and the item is AUTONOMOUS.
DEFERRABLE_CLASS = "DECISION"
# Reserved word that CLEARS an optional field instead of setting it. `--risk ''`
# cannot do the job: argparse hands an empty string, every writer treats it as
# falsy, and the command is a silent no-op — so a Risk line written when it was
# true (a branch that has since been merged, a migration already run) was
# unremovable, and a stale Risk keeps the item out of every afk package forever.
# A reserved value reuses the existing parser: no new flag to forget, no new
# precedence rule between "set" and "clear".
FIELD_CLEAR = "none"
# Fields the reserved word may DELETE. All three are true-when-written and go
# stale: a Risk whose branch has since merged, a deferral whose class has since
# changed, an Env naming the machine an item needed before it was re-sliced.
# None is ever deleted in a way that opens a gate — see cmd_edit.
#
# **Claimed:** ages exactly like these and is deliberately ABSENT: this set is
# consulted by `edit`'s field loop, and a field that loop can CLEAR is one it can
# also SET — `edit <id> --claimed bravo` would take an item somebody else holds,
# in one command, which is the thing `claim` exists to refuse. It is cleared by
# `release`, which reads the same chain and splices with the same helper.
CLEARABLE = frozenset(("Risk", "Deferred", "Env"))
READERS = frozenset(("list", "report"))   # everything else mutates and takes the queue lock
LOCK_TIMEOUT = 10                         # seconds a mutating command waits for that lock
# read once, at import: os.umask can only be read by setting it, and doing that
# mid-run would race any other thread writing a file (the suite writes from six)
UMASK = os.umask(0)
os.umask(UMASK)
CEILING = 700          # chars per ITEM BLOCK; enough for title + fields + 1 link
CEILING_FORCED = 2000
# chars per FIELD VALUE. The block ceiling cannot be the only one: the fields a
# legacy oversized item must stay able to gain are exempt from it (see cmd_edit),
# so without a second ceiling the first is bypassed by choosing another flag —
# measured before this existed: `edit <id> --criterion "<900 chars>"` took a
# 100-char item to 1014 and returned 0.
#
# The fields split by NATURE, and that split is what decides which ceiling each
# one answers to (see cmd_edit for the block half):
#   SHORT   --class (enum), --effort ("M (~30min)"), --project (a slug) are bounded
#           by construction. Small ceiling, and exempt from the block ceiling —
#           that exemption is the whole point of T071: tagging a legacy oversized
#           item must not require --force.
#   FREE    --criterion, --risk, --source, and the close flags, are prose. A field
#           ceiling alone does NOT bound them: three of them at 199 chars each, in
#           ONE call, took an item to 709 chars past a 700 block ceiling with no
#           --force. So these also put the resulting BLOCK through the block
#           ceiling, exactly as --text does.
#   NEITHER --env, alone, answers to no ceiling here, and that is not an oversight: its
#           value must EQUAL an entry of the site file's roster, and a roster entry is a
#           bounded slug (tk_site.NAME_RE) — a gate strictly tighter than either ceiling
#           above, applied to the file the value comes from rather than to the flag. Do
#           not add it to check_field_ceilings "for consistency": that would put a
#           second, looser bound on a value the roster already decides, and the day a
#           legitimate machine name crossed it the queue would refuse a name its own
#           roster accepts. Like the short fields, it is exempt from the block ceiling
#           (it is absent from FREE_TEXT_FLAGS), for the same T071 reason. The same
#           answer covers ensure_single_line and ensure_no_embedded_marker, which it
#           also skips: a newline and a `**Field:**` shape are both unspellable inside
#           NAME_RE, so those guards would be re-checking what the roster settled.
FIELD_CEILING_SHORT = 60
FIELD_CEILING_SHORT_FORCED = 150
FIELD_CEILING = 200
FIELD_CEILING_FORCED = 500
SHORT_FLAGS = frozenset(("classe", "class", "effort", "project"))
# the free-text item fields: an edit touching any of them measures the block
FREE_TEXT_FLAGS = ("text", "criterion", "risk", "deferred")
PROJECTS_ROOT = os.path.expanduser("~/.claude/projects")

DONE_LOG_TEMPLATE = """---
name: done-log
description: log de execução — itens que saíram da fila next-steps, com data e ponteiro
metadata:
  type: project
---

# Done log

Escrito somente pelo `tk-queue` (done/cancel/migrate). Uma linha por item;
o ponteiro aponta para o endereço mais durável (PR/commit > wiki/doc >
arquivo de memória). A linha deve fazer sentido sozinha se o ponteiro morrer.
"""


def fail(msg):
    sys.exit(f"tk-queue: {msg}")


def memory_dir(explicit):
    if explicit:
        d = os.path.abspath(os.path.expanduser(explicit))
    else:
        slug = re.sub(r"[^A-Za-z0-9-]", "-", os.getcwd())
        d = os.path.join(PROJECTS_ROOT, slug, "memory")
    if not os.path.isdir(d):
        fail(f"memory dir not found: {d}\n(use --dir, or run from the project's directory)")
    return d


def read(path):
    if not os.path.exists(path):
        return None
    with open(path, encoding="utf-8") as f:
        return f.read()


def write_atomic(path, text):
    """Write via a temp file in the same directory, then os.replace — a reader
    sees the whole old file or the whole new one, never a half.

    The temp name must be UNIQUE. A fixed one (`path + ".tk-queue.tmp"`) is
    shared state between processes: two concurrent writers open and truncate
    the same temp, and whichever calls os.replace second renames the other's
    half-written bytes into place. Measured on this script before the fix: the
    queue file came back truncated to one item and ID allocation restarted at
    T001 — while both `add` calls had reported success.
    """
    d = os.path.dirname(path) or "."
    fd, tmp = tempfile.mkstemp(dir=d, prefix=os.path.basename(path) + ".tk-queue.",
                               suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        # mkstemp creates 0600 — carry over the mode the queue file already had
        # (or the umask default for a new one), or the rename silently narrows a
        # world-readable memory file to owner-only
        try:
            mode = os.stat(path).st_mode & 0o7777
        except FileNotFoundError:
            mode = 0o666 & ~UMASK
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


@contextlib.contextmanager
def queue_lock(memdir):
    """Serialize the read-modify-write that every mutating command performs.

    Read → compute → write is not atomic even when the write is: two writers
    interleave, and the second computes from a snapshot that predates the
    first, so the first item is silently lost. The caller is then told "no open
    item" and adds a duplicate — the failure this lock exists to prevent.
    Holding it across the WHOLE command is what makes the read authoritative.

    Advisory (flock), which is enough: the contract already makes this script
    the queue's only writer. Readers (`list`, `report`) take no lock — every
    write lands with os.replace, so a reader sees a coherent file regardless.
    """
    if fcntl is None:
        # No flock (non-POSIX): the unique temp name and the honest miss report
        # still hold; only cross-process serialization is unavailable.
        yield
        return
    path = os.path.join(memdir, ".tk-queue.lock")
    fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o644)
    try:
        deadline = time.monotonic() + LOCK_TIMEOUT
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError:
                if time.monotonic() >= deadline:
                    fail(f"another tk-queue still holds {path} after {LOCK_TIMEOUT}s "
                         "— a concurrent session is writing this queue. Nothing was "
                         "changed; re-run `tk-queue list` and retry.")
                time.sleep(0.05)
        yield
    finally:
        os.close(fd)       # closing the fd releases the flock


# --- item parsing ---------------------------------------------------------
# An item block starts at a top-level "- [ ]" / "- [x]" line and runs until
# the first blank line, next item, or heading. Everything else in the file
# (frontmatter, headings, prose) is preserved verbatim.

# --- the two grammars, ONE spelling each ----------------------------------
# Two shapes carry an ID in these files, and every reader of one is BUILT from the
# strings below — ITEM_ID_RE, ID_RE and cmd_edit's canonical head alike, none of
# them respelling the grammar: a next-steps item from MARKER (+ DECOR + ID_SLOT
# for its ID), a done-log entry from LOG_LINE. Two readers of the same shape
# spelling it differently is not a style question — it is how the same line came
# to allocate an ID in one file and not in the other (see the allocation note
# below), and how `list` came to leak a raw `T012~~**` into a title.
MARKER = r"- \[( |x)\] "                        # group 1: the box
# What a human may put between the box and the ID, and what the ID itself may be
# wrapped in. The DISCRIMINATOR is prose, and prose is WORDS: DECOR admits only
# characters that are neither alphanumeric nor a line break, at most DECOR_MAX of
# them, so "✅ " and "~~" get through and "feito junto com o " cannot — one word
# character and the match is over. Emoji before the ID is the real house style,
# not a hypothetical: the m365 queue carries
# `- [x] ✅ **T020** — Defaults de compartilhamento ...` today, and a slot that
# tolerated only `~~` made that allocation invisible — the direction that hands
# the number out twice. The ceiling is what keeps DECOR a decoration rather than
# a wildcard; it fits an emoji plus a space plus a strikethrough (4 chars), with
# room for a variation selector or a ZWJ sequence.
DECOR_MAX = 6
DECOR = r"[^\w\n]{0,%d}" % DECOR_MAX
# group 2 after MARKER (+ DECOR): the ID. The strikethrough may sit on either
# side of the bold — `~~**T012**~~` is DECOR + slot, `**~~T012~~**` is the slot's
# own inner pair. Both are how a human ticks off a legacy item, and reading only
# one of them left the other free to be handed out a second time.
ID_SLOT = r"\*\*(?:~~)?T([0-9]{3,})(?:~~)?\*\*"
LOG_LINE = r"- ([0-9]{4}-[0-9]{2}-[0-9]{2}) — "  # group 1: the date

ITEM_START = re.compile("^" + MARKER, re.M)
# the same bold ID ANYWHERE in a block — a citation, not an allocation. Built
# from ID_SLOT so a form the allocator reads is a form item_title strips: spelled
# separately, `**~~T012~~**` was an ID for one and raw text for the other, and
# `list` leaked the fragment `T012~~**` into the title.
ID_RE = re.compile(r"(?:~~)?" + ID_SLOT + r"(?:~~)?")

# --- where an ID is ALLOCATED, as against merely MENTIONED -----------------
# An ID counts as taken only where a WRITER of these files PUTS it. There are
# exactly three such positions, one per writer:
#
#   next-steps.md  the item marker        "- [ ] **T007** — ..."   compose_item, migrate
#   done-log.md    an entry's ID column   "- 2026-08-13 — FEITO — T072 ..."  append_done_line
#   done-log.md    a legacy [x] line moved verbatim by `migrate`
#
# Everywhere else a T-number is PROSE: a --note reading "atribuiu IDs até T022",
# a --summary, an outcome naming a sibling ticket still open in ANOTHER project,
# an item's own text quoting a duplicate. Scanning the whole text of both files
# counted every one of those as allocated and BURNED the next number — measured
# 2026-08-14 on this queue: a note saying an item "virou T0NN" made the following
# `add` skip that number. It is not hypothetical residue either — the real files
# still carry T054 and T086 as prose-only ghosts, counted as taken by nothing.
# And the damage is unbounded in one direction: a single HIGH id quoted in prose
# (a sibling tracker's "T900") jumps the counter for good.
#
# The same rule decides the diagnostic (see missing_item_message): an ID nobody
# ever handed out must be reported as never allocated, not as one a concurrent
# writer clobbered — that answer sends the caller hunting a writer that never
# existed. `id_in_done_log` already worked this way; these make the rest of the
# script agree with it.
#
# The first and third positions are the SAME LINE, before and after `migrate`
# moves it — so they must be the same regex, or the file it currently sits in
# decides the answer. Reading the legacy line loosely (any bold ID anywhere on
# it) gave exactly that split: `- [x] feito junto com o **T900** do outro
# tracker` allocated nothing in next-steps and burned T900 the moment `migrate`
# moved it verbatim, and `- [x] ~~**T012**~~ — legado` did the opposite, leaving
# T012 free to be handed out a second time while it sat in next-steps. ONE
# regex, ITEM_ID_RE, therefore reads the marker's ID SLOT in both files: the ID
# is at the head of the line, DECORATION tolerated (a strikethrough, an emoji —
# that is how a human ticks off or flags a legacy item) but never a word, because
# anything after a word of prose IS prose. It stays blind to the box on purpose
# (one regex, not two): an ID parked in the log under an OPEN box — `- [ ]
# **T005**` sitting in done-log.md — is still spent, and refusing to see it is
# the direction that hands the number out twice. Both tolerances are one-way:
# they can only make MORE IDs count as taken, never fewer.
ITEM_ID_RE = re.compile("^" + MARKER + DECOR + ID_SLOT, re.M)
LOG_ID_RE = re.compile("^" + LOG_LINE + r"\S+ — T([0-9]{3,})\b", re.M)
# the head `edit --text` rewrites: the same marker + ID slot, plus the separator
# compose_item writes. Built here, not respelled in cmd_edit, so a head the
# allocator accepts is a head --text can rewrite — a legacy item whose head
# carries an emoji is editable, and no second grammar can drift from this one.
# The box is not re-checked: cmd_edit only ever sees a block find_open_item
# returned, and those are open by construction.
CANONICAL_HEAD_RE = re.compile(MARKER + DECOR + ID_SLOT + " — ")


def split_blocks(body):
    """Return a list of (kind, text) where kind is 'item-open'/'item-done'/'other'."""
    blocks, buf, kind = [], [], "other"
    for line in body.splitlines(keepends=True):
        m = ITEM_START.match(line)
        if m:
            if buf:
                blocks.append((kind, "".join(buf)))
            buf, kind = [line], ("item-done" if m.group(1) == "x" else "item-open")
        elif kind.startswith("item") and (line.strip() == "" or line.startswith("#")):
            blocks.append((kind, "".join(buf)))
            buf, kind = [line], "other"
        else:
            buf.append(line)
    if buf:
        blocks.append((kind, "".join(buf)))
    return blocks


def item_id(text):
    """The block's OWN id — the one in its marker's ID slot, never one its text
    or a continuation note happens to quote. Group 2: group 1 is the box."""
    m = ITEM_ID_RE.match(text)
    return int(m.group(2)) if m else None


# CLI-facing ID parser: the queue DISPLAYS "T006" everywhere and the contract
# writes `done <id>`, so the displayed form must be accepted. ASCII digits only
# ([0-9], never \d): Python's int() would also swallow surrounding whitespace,
# underscores ("1_0" → 10) and Unicode digits ("０６" → 6), which is a looser
# grammar than `done N`, not the same one.
ID_INPUT_RE = re.compile(r"[Tt]?([0-9]+)")


def parse_id(raw):
    m = ID_INPUT_RE.fullmatch(raw)
    if not m:
        raise argparse.ArgumentTypeError(
            f"invalid id: {raw!r} (expected T006, t006, 006 or 6)")
    return int(m.group(1))


def ids_at(content, *positions):
    """The IDs really carried by the given structural positions in `content`.
    Group 2 in every one of them — group 1 is the box or the date."""
    return {int(m.group(2)) for rx in positions for m in rx.finditer(content)}


def done_log_ids(memdir):
    """Every ID the done-log has really handed out: an entry's ID column, and
    the marker's ID slot on a legacy [x] line moved verbatim by `migrate`.

    Two callers, and they must not disagree: `max_id` decides which ID the next
    `add` gets, `id_in_done_log` decides whether a missing one was closed. Two
    copies of this loop is how one of them would keep a position the other had
    already dropped.
    """
    return ids_at(read(os.path.join(memdir, "done-log.md")) or "", LOG_ID_RE, ITEM_ID_RE)


def max_id(memdir):
    open_items = read(os.path.join(memdir, "next-steps.md")) or ""
    return max(ids_at(open_items, ITEM_ID_RE) | done_log_ids(memdir), default=0)


def ensure_single_line(**fields):
    for name, val in fields.items():
        if val and "\n" in val:
            fail(f"--{name} must be single-line — a newline would break the queue's block format")


def ensure_filled(**fields):
    """argparse's required=True only proves the flag was typed. An empty string
    satisfies it and would write a field-less item — the exact gap a mandatory
    field exists to close."""
    for name, val in fields.items():
        if not (val or "").strip():
            fail(f"--{name} cannot be blank")


def ensure_no_embedded_marker(**fields):
    """Refuse a field-marker shape (`**Project:**`) inside free text.

    Once composed into the block, an embedded marker is indistinguishable from
    the real field it precedes, and every reader takes the FIRST match:
    item_title truncates the title there, PROJECT_TAG_RE reads the next word as
    the project tag, `list` then groups the item under it, and `edit` rewrites
    the prose instead of the field. That is the whole T063 incident — an item
    whose text said "**Project:** para o done-log" acquired the tag "para".

    The trigger is deliberately narrow: the literal bold-colon shape with a
    capitalised field name. Prose that merely says "risk" or "projeto" never
    matches — only bolding it with a trailing colon does. Refusing beats
    escaping: an escape would need a matching unescape in every reader and in
    the display path, each one a fresh chance to reintroduce this same bug.
    """
    for name, val in fields.items():
        if val and EMBEDDED_MARKER_RE.search(val):
            fail(f"--{name} contains a field-marker shape (e.g. **Project:**), which would "
                 "be read as the real field and silently hijack it. Rephrase without the "
                 "bold '**Word:**' shape — e.g. 'the Project field', or `Project:` in a "
                 "code span.")


FIELD_VARIANTS = {
    "Class": r"Class(?:e)?",
    "Effort": r"(?:Effort|Esforço)",
    "Risk": r"(?:Risk|Risco)",
    "Criterion": r"(?:Criteri(?:on|o)|Critério)",
    "Project": r"(?:Project|Projeto)",
    "Source": r"(?:Source|Fonte)",
    "Deferred": r"(?:Deferred|Adiado)",
    "Env": r"(?:Env|Ambiente)",
    "Claimed": r"(?:Claimed|Posse)",
}
ANY_FIELD = "|".join(FIELD_VARIANTS.values())
# the marker SHAPE alone, with no trailing value — every other use of ANY_FIELD
# parses a real field; this one refuses the shape inside free text
EMBEDDED_MARKER_RE = re.compile(r"\*\*(?:" + ANY_FIELD + r"):\*\*")
# the same shape, per field: what a reader asks when the question is "does a marker
# for THIS field sit anywhere in the block, including where no reader may use it?"
FIELD_MARKER_RE = {name: re.compile(r"\*\*(?:" + variants + r"):\*\*")
                   for name, variants in FIELD_VARIANTS.items()}
PROJECT_RE = re.compile(r"\A[a-z0-9][a-z0-9_-]*\Z")
# single source for reading a tag back out: the warning and the grouping must
# see the same tag, or an item warns as unprecedented and then groups elsewhere
PROJECT_TAG_RE = re.compile(r"\*\*(?:" + FIELD_VARIANTS["Project"] + r"):\*\*\s*([^\s.*]+)")
# same field, but anchored to end-of-line, for reading the tag back out of a
# done-log entry's FIRST line only (see log_entry_tag). An entry's remaining
# lines are a free-text --note that can itself quote "**Project:**" in prose —
# a real case in this queue's own log — and searching the whole entry would
# read that prose as the tag, which is precisely the T063 failure
LOG_TAG_RE = re.compile(r"\*\*(?:" + FIELD_VARIANTS["Project"] + r"):\*\*\s*([^\s.*]+)\.\s*$")


FIELD_SEGMENT_RE = re.compile(r"\*\*(" + ANY_FIELD + r"):\*\*[^*\n]*")


def canonical_field(raw):
    """Map a matched field word ('Risco', 'Criterio') to its canonical name."""
    for name, variants in FIELD_VARIANTS.items():
        if re.fullmatch(variants, raw):
            return name
    return None


def field_chain(block):
    """The item's REAL field chain: the maximal run of `**Field:** value.`
    segments ENDING the block's first line. Empty when no such run exists.

    Why a chain, and not "the last marker in the block". An item block absorbs
    its continuation lines, and a legacy item — precisely the population the
    ceiling exemption exists to serve, and the one `ensure_no_embedded_marker`
    never protected, since it only guards items added after it — can carry the
    marker SHAPE in prose: before the fields, or on a note line after them.
    Taking the last match then edits the NOTE and leaves the real field alone,
    while reporting success. Measured on `--risk none`: the real Risk survived
    untouched and the note's text was deleted instead — a no-op on the field the
    command claimed to change, plus destruction of text nobody asked it to touch,
    on the DELETION path.

    Two conditions separate chain from prose, and neither works alone:

      anchored   the run must reach the end of the line. The fields are a suffix
                 of the first line, by construction (compose_item).
      periods    each segment's value ends in '.', because compose_item writes
                 `**Field:** value.` — the ONE exception being Source, which is
                 written last and without one. Contiguity cannot stand in for
                 this: the body is greedy, so a prose marker's match runs right
                 up to the next marker and looks contiguous too. The period is
                 what tells `**Project:** para o done-log **Class:** ...` (prose)
                 from `**Project:** tk. **Source:** ...` (a real field).

    Ambiguity is left for the caller to resolve (see cmd_edit), never guessed:
    a refusal costs one command, deleted text is not recoverable.
    """
    line = block.split("\n", 1)[0]
    segs = list(FIELD_SEGMENT_RE.finditer(line))
    if not segs or segs[-1].end() < len(line.rstrip()):
        return []
    chain = [segs[-1]]
    for m in reversed(segs[:-1]):
        ends_field = (m.group(0).rstrip().endswith(".")
                      or canonical_field(m.group(1)) == "Source")
        if m.end() != chain[0].start() or not ends_field:
            break
        chain.insert(0, m)
    return chain


def clears_field(value):
    """Whether this flag value is the reserved word that DELETES the field.

    Case-insensitive and whitespace-tolerant, so `--risk None` and `--risk ' none '`
    do not silently write a Risk line reading "None" — a Risk field whose content
    is the word for "no risk" is never what the caller meant.
    """
    return (value or "").strip().lower() == FIELD_CLEAR


def clear_field_segment(block, segment):
    """`block` with one field SEGMENT removed, and the removal site repaired.

    ONE implementation, two callers — `edit --<field> none` and `release` — because
    neither half below is obvious, and a second copy is how one caller would keep a
    rule the other had already dropped.

    Local names only, and that is not style: the caller's `start` holds the item's
    offset in the FILE, and its final splice is computed from it. A branch that put
    the field's own offsets into names spelled the same way truncated the
    frontmatter mid-word and duplicated the item — measured on `--risk none`, with
    the whole suite still green, because every clearing test asserted
    `assertNotIn("**Risk:**")` and a corrupted file satisfies that too.

    The repair: FIELD_SEGMENT_RE's body is greedy, so the match has already
    swallowed the blank that separated this field from the next one — but when the
    field was the LAST on its line there is nothing after it, and the blank BEFORE
    it is left dangling at end of line. It is repaired exactly at the removal site:
    a sweep over the whole block would also eat a two-space Markdown hard break on
    an unrelated continuation line, silently rewrapping text this command was never
    asked to touch.
    """
    f_start, f_end = segment.span()
    head, tail = block[:f_start], block[f_end:]
    if tail[:1] in ("", "\n"):
        head = head.rstrip(" \t")
    return head + tail


CLASS_VALUE_RE = re.compile(r"\*\*(?:" + FIELD_VARIANTS["Class"] + r"):\*\*\s*([A-Za-zÀ-ÿ]+)")


def item_class(block):
    """The class word an item carries, or None. One spelling for `list` and for
    the deferral gate: a class the display reads and the gate does not is how the
    two would disagree about what an item IS."""
    m = CLASS_VALUE_RE.search(block)
    return m.group(1) if m else None


def chain_class(block):
    """The class the item really carries, read from its FIELD CHAIN — the stricter
    reader the deferral gate uses, and deliberately not `item_class`.

    `item_class` searches the whole block and takes the leftmost match, which is
    what `list` has always displayed. That is too loose to decide a gate: an item
    whose prose says `nota: itens **Class:** DECISION são raros aqui.` before its
    real `**Class:** AUTONOMOUS.` reads as DECISION, and `edit <id> --deferred x`
    then wrote a deferral onto an AUTONOMOUS item — the very state the flag is
    refused for.

    Returns None when the chain names no class — a legacy item whose fields sit on
    a continuation line — and equally when it names TWO, which is exactly what a
    prose marker absorbed into the chain looks like. Ambiguity is refused, not
    guessed: the same answer `edit`'s own field loop already gives for a duplicated
    field, and the gate then asks for `--class` explicitly, which costs one command.
    """
    found = [m for m in field_chain(block) if canonical_field(m.group(1)) == "Class"]
    if len(found) != 1:
        return None
    value = re.match(r"\*\*[^*]+:\*\*\s*([A-Za-zÀ-ÿ]+)", found[0].group(0))
    return value.group(1) if value else None


def qualified_fields(block, field):
    """(the chain segments of `field` that QUALIFY, how many `field` markers the
    whole block carries) — the position rule every gate reads its field through.

    A real field is a chain segment that FOLLOWS the **Class:** compose_item writes
    first. "Somewhere in the chain" is not enough, and the difference is a bypass
    in one direction and a DELETION in the other: field_chain absorbs any run of
    `**Field:** value.` segments that ends the line, so an item's own prose can
    OPEN that run — `— item, ver a **Deferred:** nota de contexto. **Class:**
    AUTONOMOUS. …` parses as a five-field chain. Both halves are measured, on this
    script, one slice apart:

      the gate     `edit <id> --class DECISION` went through with no justification
                   at all, the gate having read the prose as the field — and the
                   later auto-clear then DELETED that prose from the item's text.
      the deletion `release` on `— ver a **Posse:** do item com alguém. **Class:**
                   …` reported success and cut those four words out of the item's
                   own title, while `claim` had refused the item naming an owner
                   made of three words of that same title.

    The marker COUNT is what keeps the other direction honest: a marker the
    position rule refuses to read is not thereby harmless. The caller is told, and
    nothing is guessed — see deferral_for_edit and claim_segment, which is where
    the two gates part company (one refuses only when the command depends on the
    field; the other always does, since every claim command depends on it).
    """
    chain = field_chain(block)
    names = [canonical_field(m.group(1)) for m in chain]
    segs = []
    if "Class" in names:
        after = names.index("Class")
        segs = [m for i, m in enumerate(chain) if names[i] == field and i > after]
    return segs, len(FIELD_MARKER_RE[field].findall(block))


def chain_hosts_class(block):
    """Whether the item's field chain carries the **Class:** that qualified_fields
    positions every real field against.

    A writer has to ask this BEFORE writing such a field: a chain with no Class
    qualifies nothing, so a field written into one can never be read back. Measured
    on `claim`, before this existed — the item came back held in the FILE, shown
    FREE by `list` (which is the collision the command exists to prevent, made
    permanent), and refused by `release` forever, leaving the queue editable only by
    the hand the contract forbids.
    """
    return any(canonical_field(m.group(1)) == "Class" for m in field_chain(block))


def deferral_field(block):
    """(segment, stray) — the item's REAL Deferred field, and whether a
    `**Deferred:**` marker sits anywhere else in the block. The position rule that
    decides "real", and the two incidents that bought it: qualified_fields."""
    segs, markers = qualified_fields(block, "Deferred")
    seg = segs[0] if segs else None
    return seg, markers > (1 if seg else 0)


def deferral_gate_message(cmd):
    """Why the command was refused, and BOTH ways out — a message naming only the
    flag teaches the flag, and the flag is the exception, not the default path."""
    return (
        f"`{cmd} --class {DEFERRABLE_CLASS}` requires --deferred. A {DEFERRABLE_CLASS} "
        "item parks the queue until the user is back, so parking it must be deliberate. "
        "Two paths:\n"
        "  ASK the decision now and write it into the item's text and --criterion — the "
        "item is then AUTONOMOUS and an unattended session can run it (the default path);\n"
        "  or DEFER it on the record: --deferred \"<why it could not be asked>\" "
        "(an afk session passes --deferred afk).")


def deferral_class_message(subject_is):
    """Why a deferral was refused on a class that is not DECISION. One wording for
    `add` and `edit` alike: two sites saying this in two ways is how one of them
    came to be guarded and tested while the other was neither."""
    return (f"--deferred qualifies --class {DEFERRABLE_CLASS} and nothing else — it records "
            f"why a decision could not be asked, and no reader honours it elsewhere. "
            f"{subject_is} Pass `--class {DEFERRABLE_CLASS}` in the same command, or drop "
            "--deferred.")


def validate_env(value):
    """Refuse an `--env` the site file's roster does not carry.

    EXACT equality, and nothing is normalised. The roster is the only thing that
    says an environment exists, so a value outside it is a typo — and a typo
    accepted is worse than one refused: the item is filtered out of every
    package on every machine, forever, with no error anywhere to say why. That
    is the phantom environment the roster exists to prevent, which is why the
    answer here is a refusal and not a warning.

    The reserved clear word is let through untouched: DELETING the field names
    no environment, so it consults no roster — a machine with no site file at
    all must still be able to un-pin an item.
    """
    if value is None or clears_field(value):
        return
    try:
        site = tk_site.load()
    except tk_site.SiteError as e:
        fail(str(e))
    if site is None:
        fail("--env: " + tk_site.missing_file_message())
    if value not in site.environments:
        fail(f"--env {value!r} is not in the roster of {site.path}: "
             f"{', '.join(site.environments)}. The match is exact, capitals included — "
             "a near-miss would pin the item to an environment that does not exist, and "
             "no machine would ever pick it up. Fix the value, or add the environment to "
             "the roster.")


# --- claim: who holds the item, and since when ----------------------------
# A claim is COORDINATION between sibling sessions on one queue — it is not a
# security boundary. That is what decides the two liberties below, and both are
# deliberate: `release` does not demand the owner's name, because a session that
# died holding a claim would otherwise leave the item unreachable (a lock with no
# timeout); and `done`/`cancel` do not consult it either, because they already
# record the outcome in the done-log, and demanding `--as` on every close would
# make a crashed session's item unclosable. What keeps a wrongful release honest
# is that the command PRINTS whose claim it dropped.
#
# An owner is a bounded token, and that bound IS the validation: the value is
# written verbatim into a one-line field right beside a timestamp, so a name
# carrying a blank could not be told apart from the moment it was claimed, and one
# carrying a newline or a `**Field:**` shape would break the block format. The
# shape gate is strictly tighter than the single-line, embedded-marker and field
# ceilings the prose flags answer to — the same answer `--env` gets from the
# roster — so those are not repeated on it. Capitals, dots and underscores are
# allowed where a roster name refuses them: an owner is a session or host label
# ("alpha.local", "sess-3"), not a name matched by equality against a file.
OWNER_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,31}\Z")
# ONE spelling of the value's grammar, composed and read back from the same
# constant: two of them is how a refusal comes to name an owner the file never
# carried.
CLAIM_SINCE = " since "
CLAIM_VALUE_RE = re.compile(r"\*\*[^*]+:\*\*\s*(\S+)" + CLAIM_SINCE + r"(\S+?)\.?\s*\Z")


def now_stamp():
    """UTC, to the second.

    Not the date-only stamp the rest of the script writes: a claim is read over
    the interval two sessions collide in, which is minutes, and a field that says
    only "today" answers none of the questions it exists for. UTC because one
    queue is shared by more than one machine by construction — that is what
    **Env:** is for — and two local times from two machines do not compare.
    """
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def validate_owner(name):
    """argparse's required=True only proves --as was typed; an empty string
    satisfies it and would claim the item for nobody."""
    if not OWNER_RE.match(name or ""):
        fail(f"--as {name!r} is not a valid owner name: letters, digits, '.', '-' or "
             "'_', at most 32 chars, no spaces and not empty. The name sits beside the "
             "timestamp in a one-line field, and one with a blank in it cannot be told "
             "apart from the moment it was claimed.")
    if clears_field(name):
        fail(f"--as {FIELD_CLEAR!r} is refused: {FIELD_CLEAR!r} is the word that DELETES a "
             "field everywhere in this script, so an item claimed under it would read as "
             "one nobody holds. Hand an item back with `tk-queue release <id>`.")


def claim_segment(iid, block):
    """The item's REAL **Claimed:** field — the one in its FIELD CHAIN — or None.

    Read through qualified_fields, so a marker sitting BEFORE the **Class:** — the
    item's own prose, absorbed into the chain because it happens to end in a period
    — is not the claim. That is not a hypothetical: `release` on such an item cut
    four words out of its title and reported success.

    Refuses rather than guessing, in both directions, because this reader decides a
    GATE and the deferral field had already paid for both lessons:

      ambiguous   two qualifying Claimed fields: which one holds the item is
                  unanswerable, and picking either lets the other be overwritten.
      stray       a `**Claimed:**` marker anywhere the position rule will not read
                  — the item's own prose, or a continuation line. Reading it as the
                  field would let prose hold an item forever; ignoring it would have
                  `release` report a free item while that text still says otherwise.

    Unlike `edit`, this refuses UNCONDITIONALLY rather than only when the command
    depends on the field: `claim` and `release` are commands about the claim and
    nothing else, so there is no unrelated edit here to over-refuse.

    Both populations are legacy only: ensure_no_embedded_marker refuses the marker
    shape in every free-text flag, and Claimed is a field it knows.
    """
    segs, markers = qualified_fields(block, "Claimed")
    if len(segs) > 1:
        fail(f"T{iid:03d} carries {len(segs)} **Claimed:** fields in its field chain, so "
             "who holds it is ambiguous. Nothing was changed. Close it with `cancel` and "
             "re-add it clean.")
    seg = segs[0] if segs else None
    if markers > (1 if seg else 0):
        fail(f"T{iid:03d} carries a **Claimed:** marker away from the position a claim is "
             "written in (after **Class:**) — in the item's own prose, or on a continuation "
             "line. Nothing was changed: reading it as the claim would let prose hold the "
             "item forever, and ignoring it would report a free item while that text says "
             "otherwise. Close it with `cancel` and re-add it clean.")
    return seg


def claim_value(segment):
    """(owner, since) carried by a Claimed segment.

    A value that does not parse comes back as (the raw value, None) and NEVER as
    "unclaimed": "held, and I cannot tell by whom" is still held, and reading it as
    free is exactly how the second session takes an item the first is working.
    """
    m = CLAIM_VALUE_RE.match(segment.group(0))
    if m:
        return m.group(1), m.group(2)
    return re.sub(r"\A\*\*[^*]+:\*\*\s*", "", segment.group(0)).strip(), None


def claim_mark(owner, since):
    """One wording for the refusal, the release report and `list` alike."""
    return f"claimed by {owner}" + (f" since {since}" if since
                                    else " (with no readable timestamp)")


def displayed_claim(block):
    """The claim `list` shows, or None — read from the FIELD CHAIN, the same place
    the gate reads it from, so the display and the refusal cannot disagree about
    who holds an item.

    Tolerant where the gate refuses, and that is the difference between a reader
    and a gate: `list` must not die on one malformed item and stop showing the
    other twenty. What the two DO agree on is the only thing that matters here —
    the POSITION rule, which is not relaxed: a display reading the item's own prose
    as a claim would show an owner made of three words of the title.

    Where they part is the STRAY marker, and only in the safe direction. An item
    carrying a real claim AND a marker elsewhere is displayed as claimed — which is
    true, somebody holds it — while `claim`/`release` refuse it over the marker,
    which is a defect in the item rather than an answer about who holds it. A
    reader who skips it loses nothing, and one who tries to take it is refused.
    """
    segs, _ = qualified_fields(block, "Claimed")
    return claim_mark(*claim_value(segs[0])) if len(segs) == 1 else None


def validate_project(tag):
    if not PROJECT_RE.match(tag):
        fail(f"--project must be a short lowercase slug (letters, digits, '-'/'_', "
             f"no spaces or dots): {tag!r}")


def open_project_tags(content):
    """Project tags carried by currently-open items of a next-steps.md body."""
    tags = set()
    for kind, text in split_blocks(content or ""):
        if kind != "item-open":
            continue
        m = PROJECT_TAG_RE.search(text)
        if m:
            tags.add(m.group(1))
    return tags


def group_by_tag(pairs, by_position=False):
    """(tag, payload) pairs → ordered [(tag, [payload, ...])], the untagged group
    LAST — that group is a residue, not a project. Returns None when nothing
    carries a tag, so the caller prints its flat form and an untagged queue looks
    exactly as it did before tags existed.

    `list` and `report` group on different things (open items vs done-log
    entries) under different heading levels, but the ordering rule is one rule
    and belongs in one place. Where they part is WHICH order the groups come in,
    and each follows the axis its file is ordered by:

      by_position   `list`. The queue's order IS its priority, so the groups
                    follow the file: each one sits where its top item sits.
                    Sorting them alphabetically instead made `bump` INVISIBLE on
                    any tagged queue — the item reached the top of the file and
                    still rendered under the third heading.
      sorted        `report`. A done-log has no priority to reflect; alphabetical
                    is the stable reading order there.
    """
    if not any(tag for tag, _ in pairs):
        return None
    groups = {}
    for tag, payload in pairs:
        groups.setdefault(tag, []).append(payload)
    named = [k for k in groups if k is not None]      # dict order == file order
    order = (named if by_position else sorted(named)) + ([None] if None in groups else [])
    return [(tag, groups[tag]) for tag in order]


def item_title(text, limit=100):
    t = re.sub("^" + MARKER, "", text.strip())
    t = ID_RE.sub("", t)
    t = re.sub(r"\*\*(" + ANY_FIELD + r"):\*\*.*", "", t, flags=re.S)
    t = re.sub(r"\s+", " ", t).strip(" —-~*")
    return t if len(t) <= limit else t[: limit - 1] + "…"


# --- done-log writing -----------------------------------------------------

def log_entry_tag(entry_text):
    """Project tag of a done-log entry, read from its first line only — never
    from the indented --note continuation lines (see LOG_TAG_RE)."""
    m = LOG_TAG_RE.search(entry_text.split("\n", 1)[0])
    return m.group(1) if m else None


def append_done_line(memdir, line, today):
    path = os.path.join(memdir, "done-log.md")
    content = read(path)
    if content is None:
        content = DONE_LOG_TEMPLATE
    month_header = f"## {today[:7]}"
    if month_header not in content:
        content = content.rstrip("\n") + f"\n\n{month_header}\n"
    # insert right after the month header so newest month stays where created
    idx = content.index(month_header) + len(month_header)
    nl = content.find("\n", idx)
    if nl == -1:  # header is the last line, no trailing newline
        content += "\n"
        nl = len(content) - 1
    content = content[: nl + 1] + line.rstrip("\n") + "\n" + content[nl + 1 :]
    write_atomic(path, content)


def excise(content, block, idx):
    """Remove the block AT `idx`, collapsing surplus blank lines ONLY at the
    removal site — spacing elsewhere in the file is not ours to touch.

    The offset is passed in, never re-derived with `content.index(block)`: an
    item's text is NOT unique in the file. An item that documents the queue's own
    format quotes another item's line verbatim in its note, and the substring
    search finds THAT copy first — measured on this script: `done T002` deleted
    the quoted copy out of T001's note and left the real T002 open, reporting
    success, and `bump T002` produced a phantom duplicate. Positions come from
    find_open_item, which walks the blocks.
    """
    before, after = content[:idx], content[idx + len(block):]
    if not after.strip():
        return before.rstrip("\n") + "\n"
    nb = len(before) - len(before.rstrip("\n"))
    na = len(after) - len(after.lstrip("\n"))
    if nb + na > 2:
        return before.rstrip("\n") + "\n\n" + after.lstrip("\n")
    return before + after


def remove_block(memdir, content, block, start):
    """`content` is the read find_open_item already made under the lock — the
    authoritative one. Re-reading here would only open a window for the file to
    have changed between the two reads, and re-finding the block by text is the
    bug excise() documents."""
    write_atomic(os.path.join(memdir, "next-steps.md"), excise(content, block, start))


def id_in_done_log(memdir, wanted_id):
    """Whether the ID really was closed — asked of the positions a close writes
    (see done_log_ids), never of the log's free text.

    Anywhere else the ID is prose. This queue's own log carries a --note saying
    "atribuiu IDs até T022" and an outcome naming a sibling ticket "T054" that
    is still open in another project — a whole-file search reads both as closed
    and answers "already left the queue", a confident wrong diagnosis from the
    error path that exists to prevent confident wrong diagnoses.
    """
    return wanted_id in done_log_ids(memdir)


def missing_item_message(memdir, content, wanted_id):
    """Why the ID is not among the open items — the four cases are NOT the same
    answer, and a flat "no open item" is the one that does damage: it reads as
    "never existed", so the caller adds the item again and the queue ends up
    with two. Every branch below says what to do instead of re-adding.
    """
    label = f"T{wanted_id:03d}"
    for kind, text in split_blocks(content):
        if kind == "item-done" and item_id(text) == wanted_id:
            return (f"{label} is in next-steps.md but already ticked [x], so it never "
                    "reached the done-log. Run `tk-queue migrate` to move it, then read "
                    "the log line — do NOT add a replacement item.")
    if id_in_done_log(memdir, wanted_id):
        return (f"{label} already left the queue — it is in done-log.md. Read that line "
                "before acting, and do NOT add a replacement item.")
    top = max_id(memdir)
    if wanted_id > top:
        return (f"{label} was never allocated in {memdir} — the highest ID in use is "
                f"T{top:03d}. Check the ID with `tk-queue list`.")
    return (f"{label} is allocated but appears in neither next-steps.md nor done-log.md. "
            "Another writer very likely removed or clobbered it. Nothing was changed. "
            "Re-read the queue with `tk-queue list` before acting — do NOT add a "
            "replacement item, that is exactly how a duplicate is born.")


def find_open_item(memdir, wanted_id):
    """(content, block, start) — the file, the item's block, and WHERE it starts.

    Called under queue_lock by every mutating command, so THIS read is the
    authoritative one: no writer can have moved the item since it was taken, and
    every caller writes from this same `content`.

    The offset is what makes the item addressable. Its TEXT is not: split_blocks
    walks the file in order, so the position is exact, while searching the text
    back out finds whichever copy comes first — including one quoted inside
    another item's note (see excise).
    """
    content = read(os.path.join(memdir, "next-steps.md"))
    if content is None:
        fail("next-steps.md not found in " + memdir)
    pos = 0
    for kind, text in split_blocks(content):
        if kind == "item-open" and item_id(text) == wanted_id:
            return content, text, pos
        pos += len(text)
    fail(missing_item_message(memdir, content, wanted_id))


# --- commands -------------------------------------------------------------

def cmd_list(args):
    memdir = memory_dir(args.dir)
    content = read(os.path.join(memdir, "next-steps.md"))
    if content is None:
        fail("next-steps.md not found in " + memdir)
    rows = []
    for kind, text in split_blocks(content):
        if kind != "item-open":
            continue
        iid = item_id(text)
        label = f"T{iid:03d}" if iid else "----"
        pm = PROJECT_TAG_RE.search(text)
        rows.append((label, item_class(text) or "?", item_title(text),
                     pm.group(1) if pm else None, displayed_claim(text)))
    if not rows:
        print("(queue empty)")
        return
    grouped = group_by_tag([(project, (label, cls, title, mark))
                            for label, cls, title, project, mark in rows],
                           by_position=True)
    if grouped is None:
        for label, cls, title, _, mark in rows:
            print(list_line(label, cls, title, mark))
    else:
        for n, (project, entries) in enumerate(grouped):
            if n:
                print()
            print(f"## {project or 'no project'}")
            for label, cls, title, mark in entries:
                print(list_line(label, cls, title, mark))
    if any(r[0] == "----" for r in rows):
        print("\nitems without ID: run `tk-queue migrate` to assign them.")


def list_line(label, cls, title, mark):
    """The claim is appended, not given a column of its own: it is the exception
    (most items are free), and a column would indent every line of every queue for
    a field almost none of them carry."""
    return f"{label}  {cls:<10}  {title}" + (f"  [{mark}]" if mark else "")


def compose_item(args, iid):
    fields = [f"**Class:** {args.classe}."]
    # right after the class it qualifies, so the two are read together
    if args.deferred and not clears_field(args.deferred):
        fields.append(f"**Deferred:** {args.deferred}.")
    fields.append(f"**Effort:** {args.effort}.")
    if args.risk and not clears_field(args.risk):
        fields.append(f"**Risk:** {args.risk}.")
    # beside Risk: the two fields that decide whether this item can be picked up
    # unattended, and where. Absent = it runs wherever the queue lives
    if args.env and not clears_field(args.env):
        fields.append(f"**Env:** {args.env}.")
    fields.append(f"**Criterion:** {args.criterion}.")
    if args.project:
        fields.append(f"**Project:** {args.project}.")
    fields.append(f"**Source:** {args.source or datetime.date.today().isoformat()}")
    return f"- [ ] **T{iid:03d}** — {args.text.strip()} " + " ".join(fields) + "\n"


def check_ceiling(item, force):
    limit = CEILING_FORCED if force else CEILING
    if len(item) > limit:
        fail(
            f"item has {len(item)} chars (ceiling {limit}). An item is a pending "
            "action, not an essay: move the context to a memory file or wiki page "
            "and link it ([[slug]])." + ("" if force else " --force raises the ceiling to "
            f"{CEILING_FORCED} for the rare exception.")
        )


def check_field_ceilings(force, **fields):
    """Measure each field VALUE against the ceiling its NATURE earns it.

    Short fields (SHORT_FLAGS) are bounded by construction and get the small
    ceiling; everything else is prose and gets the larger one — and, for the
    item fields among them, the block ceiling too (see cmd_edit), because a
    per-field ceiling alone does not bound a call that passes several at once.
    Applied identically on `add`, `edit` and the closes, or a file could hold a
    value that no later command is allowed to write.
    """
    for name, val in fields.items():
        if not val:
            continue
        if name in SHORT_FLAGS:
            limit, forced = (FIELD_CEILING_SHORT_FORCED if force
                             else FIELD_CEILING_SHORT), FIELD_CEILING_SHORT_FORCED
        else:
            limit, forced = (FIELD_CEILING_FORCED if force
                             else FIELD_CEILING), FIELD_CEILING_FORCED
        if len(val) > limit:
            fail(f"--{name} has {len(val)} chars (field ceiling {limit}). A field is one "
                 "line: put the substance in a memory file or wiki page and link it "
                 "([[slug]])." + ("" if force else f" --force raises it to {forced}."))


def cmd_add(args):
    memdir = memory_dir(args.dir)
    if args.classe not in CLASSES:
        fail(f"--class must be one of {', '.join(CLASSES)}")
    ensure_single_line(text=args.text, effort=args.effort, risk=args.risk,
                       criterion=args.criterion, source=args.source, project=args.project,
                       deferred=args.deferred)
    ensure_filled(text=args.text, effort=args.effort, criterion=args.criterion)
    if args.deferred is not None:
        # the flag was typed: an empty justification is a deferral nobody can read,
        # and argparse's own check only proves the flag was there
        ensure_filled(deferred=args.deferred)
    # the gate, in both directions. `--deferred none` is refused with the omission:
    # `none` DELETES a field everywhere else in this script, so honouring it here
    # would write a DECISION carrying no deferral — the gate open by way of the one
    # word that means "no field"
    if args.classe == DEFERRABLE_CLASS and (args.deferred is None or clears_field(args.deferred)):
        fail(deferral_gate_message("add"))
    if args.deferred is not None and args.classe != DEFERRABLE_CLASS:
        fail(deferral_class_message(f"This add is --class {args.classe}."))
    ensure_no_embedded_marker(text=args.text, effort=args.effort, risk=args.risk,
                              criterion=args.criterion, source=args.source,
                              deferred=args.deferred)
    check_field_ceilings(args.force, effort=args.effort, risk=args.risk,
                         criterion=args.criterion, project=args.project, source=args.source,
                         deferred=args.deferred)
    if args.project:
        validate_project(args.project)
    validate_env(args.env)
    path = os.path.join(memdir, "next-steps.md")
    content = read(path)
    if content is None:
        fail("next-steps.md not found in " + memdir + " (first kickoff creates it)")
    iid = max_id(memdir) + 1
    item = compose_item(args, iid)
    check_ceiling(item, args.force)
    # after every rejection path: a warning about a tag the queue then refuses
    # announces an adoption that never happened
    if args.project:
        existing = open_project_tags(content)
        if args.project not in existing:
            used = ", ".join(sorted(existing)) if existing else "(none yet)"
            print(f"tk-queue: warning: new project tag '{args.project}' — "
                  f"tags already in use: {used}", file=sys.stderr)
    # insert after the last open/done item; else append at EOF
    blocks = split_blocks(content)
    last = max((i for i, (k, _) in enumerate(blocks) if k.startswith("item")), default=None)
    if last is None:
        content = content.rstrip("\n") + "\n\n" + item
    else:
        out = []
        for i, (_, text) in enumerate(blocks):
            out.append(text)
            if i == last:
                out.append(("" if text.endswith("\n\n") else "\n") + item)
        content = "".join(out)
    write_atomic(path, content)
    print(f"added T{iid:03d}: {item_title(item)}")


def close_item(args, marker, outcome, marker_flag):
    memdir = memory_dir(args.dir)
    content, block, start = find_open_item(memdir, args.id)
    ensure_single_line(outcome=outcome, summary=args.summary)
    # --summary and the outcome share the log entry's FIRST line with the project
    # tag appended below, so a marker in them can be read as that tag. --note is
    # deliberately NOT guarded: it lands on continuation lines, which log_entry_tag
    # never reads — and a real note in this queue's log quotes "**Project:**" while
    # describing this very field, which is the case LOG_TAG_RE exists to tolerate
    ensure_no_embedded_marker(summary=args.summary, outcome=outcome)
    # the log line is a line too, and it is the record that OUTLIVES the item —
    # same ceiling, same reason. --note is the one that can legitimately carry
    # substance (it exists for work that left no pointer), which is what --force is for
    check_field_ceilings(args.force, **{marker_flag: outcome},
                         summary=args.summary, note=args.note)
    today = datetime.date.today().isoformat()
    # read the tag from the ORIGINAL block: item_title strips every field, and
    # --summary replaces the text wholesale, so by then the tag is already gone
    tag_m = PROJECT_TAG_RE.search(block)
    text = args.summary or item_title(block, limit=400)
    line = f"- {today} — {marker} — T{args.id:03d} {text} — {outcome}"
    if tag_m:
        # appended last so LOG_TAG_RE's end-of-line anchor reads this field, not
        # any earlier lookalike in the item's own text
        line += f" **Project:** {tag_m.group(1)}."
    if args.note:
        line += "\n  " + args.note.replace("\n", "\n  ")
    append_done_line(memdir, line, today)
    remove_block(memdir, content, block, start)
    print(f"T{args.id:03d} → done-log as {marker} ({today})")


def cmd_done(args):
    close_item(args, "FEITO", args.how, "how")


def cmd_cancel(args):
    close_item(args, "DESCARTADO", args.why, "why")


def deferral_for_edit(args, block):
    """What `edit` should do to the Deferred field: None (leave it), FIELD_CLEAR
    (remove it), or the new justification. Refuses every route to a DECISION item
    with no deferral on the record — the gate is on the RESULT, not on the flag,
    or each of these reaches by two commands what `add` refuses in one:

      --class DECISION with no deferral anywhere        (the #70 two-command bypass)
      --class DECISION --deferred none                  (set the class, delete the field)
      --deferred none on an item that stays a DECISION  (delete the field, keep the class)

    The gate fires on the CHANGE to DECISION, never on an unrelated edit of an item
    that already is one: every DECISION item in a real queue predates this field, and
    a gate that fired on `edit <id> --effort L` would make them all uneditable.
    """
    setting = args.deferred is not None and not clears_field(args.deferred)
    clearing = args.deferred is not None and clears_field(args.deferred)
    seg, stray = deferral_field(block)
    # Refused, not guessed — and only when the command's outcome depends on the
    # deferral (a --class or a --deferred). Reading a stray marker as the field
    # would let prose satisfy the gate; clearing it would delete that prose. An
    # edit that touches neither flag never consults the deferral, so it stays
    # allowed: over-refusing here would make the item uneditable instead.
    if stray and (args.classe or args.deferred is not None):
        fail(f"T{args.id:03d} carries a **Deferred:** marker away from the position a "
             "deferral is written in (right after **Class:**) — in the item's own prose, "
             "or on a continuation line. Nothing was changed: reading it as the field "
             "would let prose satisfy the gate, and clearing it would DELETE that prose. "
             "Close the item with `cancel` and re-add it clean.")
    has = seg is not None
    result_class = args.classe or chain_class(block)
    if args.classe == DEFERRABLE_CLASS and not (setting or (has and not clearing)):
        fail(deferral_gate_message("edit"))
    if setting and result_class != DEFERRABLE_CLASS:
        fail(deferral_class_message(
            f"T{args.id:03d} is {result_class or 'carrying no unambiguous class'}."))
    if clearing and result_class == DEFERRABLE_CLASS:
        fail(f"T{args.id:03d} would stay a {DEFERRABLE_CLASS} with no deferral on the "
             "record. A deferral is dropped by leaving the class: pass the new "
             "`--class` in the same command (the field goes with it).")
    if args.deferred is None and args.classe and args.classe != DEFERRABLE_CLASS and has:
        # a deferral left on an item that is no longer a DECISION is the stale-Risk
        # failure again: true when written, still read by every later filter
        print(f"tk-queue: T{args.id:03d} is no longer a {DEFERRABLE_CLASS} — its "
              "**Deferred:** field goes with the class", file=sys.stderr)
        return FIELD_CLEAR
    return args.deferred


def splice_item(memdir, content, block, start, new):
    """Write `new` in place of the block AT `start`.

    NEVER `content.replace(block, new, 1)`: an item's text is not unique in the
    file — one that documents the queue's own format quotes another item's line
    verbatim — and the substring search rewrites whichever copy comes first (see
    excise). The offset comes from find_open_item, which walks the blocks.

    Three callers now (`edit`, `claim`, `release`), one splice: the addressing bug
    above cost a real corruption once, and it is not a bug each command should get
    its own chance to reintroduce.
    """
    if not new.endswith("\n"):
        new += "\n"
    write_atomic(os.path.join(memdir, "next-steps.md"),
                 content[:start] + new + content[start + len(block):])


def cmd_edit(args):
    memdir = memory_dir(args.dir)
    content, block, start = find_open_item(memdir, args.id)
    ensure_single_line(text=args.text, effort=args.effort, risk=args.risk,
                       criterion=args.criterion, project=args.project,
                       deferred=args.deferred)
    if args.deferred is not None:
        ensure_filled(deferred=args.deferred)
    ensure_no_embedded_marker(text=args.text, effort=args.effort, risk=args.risk,
                              criterion=args.criterion, deferred=args.deferred)
    check_field_ceilings(args.force, effort=args.effort, risk=args.risk,
                         criterion=args.criterion, project=args.project,
                         deferred=args.deferred)
    if args.project:
        validate_project(args.project)
    validate_env(args.env)
    # before the deferral gate, which reasons about the resulting CLASS: a typo'd
    # class reaching the gate first is answered "T001 is DECISON — pass --class
    # DECISION", which sends the caller after the wrong mistake. `add` validates
    # the class first for the same reason
    if args.classe and args.classe not in CLASSES:
        fail(f"--class must be one of {', '.join(CLASSES)}")
    deferred_flag = deferral_for_edit(args, block)
    new = block
    if args.text:
        head_m = CANONICAL_HEAD_RE.match(block)
        if not head_m:
            fail(f"T{args.id:03d} has a non-canonical head — use cancel + add instead of --text")
        # keep everything from the FIRST field marker on, whichever field that is —
        # anchoring on Class alone would silently drop Effort/Risk/Source of items
        # that never carried a Class field
        tail_m = re.search(r"\*\*(?:" + ANY_FIELD + r"):\*\*.*", block, re.S)
        tail = tail_m.group(0) if tail_m else ""
        new = head_m.group(0) + args.text.strip() + (" " + tail if tail else "\n")
    for flag, field in ((args.classe, "Class"), (args.effort, "Effort"),
                        (args.risk, "Risk"), (args.env, "Env"),
                        (args.criterion, "Criterion"),
                        (args.project, "Project"), (deferred_flag, "Deferred")):
        if not flag:
            continue
        # the real field is the one in the item's FIELD CHAIN — never merely the
        # last marker in the block, which lands on a continuation note (see
        # field_chain). Ambiguity is refused, not guessed: the caller fixes a
        # refusal with one command, and cannot undo deleted text
        found = [m for m in field_chain(new) if canonical_field(m.group(1)) == field]
        if len(found) > 1:
            fail(f"T{args.id:03d} carries {len(found)} **{field}:** fields in its field "
                 f"chain, so `--{field.lower()}` is ambiguous. Nothing was changed. Close "
                 "it with `cancel` and re-add it clean.")
        if not found and re.search(r"\*\*(?:" + FIELD_VARIANTS[field] + r"):\*\*", new):
            fail(f"T{args.id:03d} has a **{field}:** marker OUTSIDE its field chain — in "
                 "the item's own prose or on a continuation line — and none inside it. "
                 "Nothing was changed. Editing that marker would rewrite prose you did "
                 "not point at (and on `--risk none`, DELETE it). Close the item with "
                 "`cancel` and re-add it clean.")
        if field in CLEARABLE and clears_field(flag):
            if found:
                new = clear_field_segment(new, found[0])
            continue
        if found:
            m = found[0]
            matched = m.group(0)
            # the body is greedy, so the match swallows the blank that separated this
            # field from the next one — hand it back, or the two fields come out glued
            new = (new[: m.start()] + f"**{field}:** {flag}."
                   + matched[len(matched.rstrip()):] + new[m.end():])
        else:
            # append at the end of the FIRST line, where the chain lives. Appending
            # after a continuation line would put the field outside the chain — i.e.
            # write, right now, the very shape the guard above refuses to touch later
            head, sep, rest = new.partition("\n")
            new = head.rstrip() + f" **{field}:** {flag}." + sep + rest
    # The BLOCK ceiling guards the item's prose, so every PROSE flag is measured
    # against it — --text and the free-text fields alike — and only when the edit
    # grows the item, since shrinking a legacy oversized item must always be allowed.
    #
    # Exempt: the short fields (--class/--effort/--project), and ONLY they. That
    # exemption is T071 and it is what the ceiling costs: gating them meant a legacy
    # oversized item (T001, T002, T013 in the real queue) needed --force merely to
    # gain a project tag, which trains the caller to type --force on edits and
    # disarms the guard where it does matter. Their own small field ceiling is what
    # bounds them, and since a field is REPLACED when present, repeated edits cannot
    # accumulate — the exemption's total cost is bounded by 3 short fields.
    #
    # Both halves of this rule were bypasses before they existed, each measured:
    # one free-text field alone took a 100-char item to 1014 chars (no --force), and
    # after the per-field ceiling closed that, three free-text fields at 199 chars in
    # ONE call still took an item to 709 past a 700 ceiling.
    if any(getattr(args, f, None) for f in FREE_TEXT_FLAGS) and len(new) > len(block):
        check_ceiling(new, args.force)
    splice_item(memdir, content, block, start, new)
    print(f"T{args.id:03d} updated")


def cmd_claim(args):
    """Take the item, so a sibling session on the same queue does not work it too.

    The check and the write happen under the SAME queue lock every mutating command
    takes (see main), and that is what makes "exactly one of two racing sessions
    wins" true rather than merely likely: find_open_item's read is authoritative
    while the lock is held, so no second writer can land between reading that the
    item is free and marking it.

    A second claim is refused even when it comes from the SAME owner. Letting it
    through would only refresh the timestamp, and the timestamp is how a reader
    tells a live claim from one a dead session left behind — a claim that renews
    itself on every attempt never looks stale.
    """
    memdir = memory_dir(args.dir)
    validate_owner(args.owner)
    content, block, start = find_open_item(memdir, args.id)
    held = claim_segment(args.id, block)
    # a gate that cannot read back what it writes must refuse to write: see
    # chain_hosts_class for the state this produced before the check existed
    if not chain_hosts_class(block):
        fail(f"T{args.id:03d} carries no **Class:** field in its field chain, and a claim "
             "is positioned against that field — one written here could not be read back, "
             "so the item would be held in the file, shown FREE by `list` and impossible "
             "to release. Nothing was changed. Give it a class first: "
             f"`tk-queue edit T{args.id:03d} --class AUTONOMOUS`.")
    if held is not None:
        fail(f"T{args.id:03d} is already {claim_mark(*claim_value(held))}. Nothing was "
             "changed: a claim is how two sessions on one queue avoid executing the same "
             "item. Take another one — or, if that session is gone, hand this one back "
             f"with `tk-queue release T{args.id:03d}`.")
    stamp = now_stamp()
    # appended at the end of the FIRST line, where the chain lives — the same place
    # `edit` puts a field it did not find, and the only place claim_segment reads
    # one back from
    head, sep, rest = block.partition("\n")
    new = head.rstrip() + f" **Claimed:** {args.owner}{CLAIM_SINCE}{stamp}." + sep + rest
    # NOT measured against the BLOCK ceiling, on the same rule as the short fields
    # (T071): the value is bounded by construction — OWNER_RE plus a fixed-width
    # stamp — and a legacy oversized item is precisely the one a session must be
    # able to take without being taught to type --force on ordinary commands.
    splice_item(memdir, content, block, start, new)
    print(f"T{args.id:03d} claimed by {args.owner} ({stamp})")


def cmd_release(args):
    """Hand a claimed item back to the queue WITHOUT closing it.

    Does not demand the owner's name, deliberately: a session that died holding a
    claim would otherwise leave the item unreachable by anyone, which is the
    failure mode of a lock with no timeout — and this queue's whole point is that
    nothing goes silently unreachable. What keeps a wrongful release visible is the
    report below, which names WHOSE claim was dropped.
    """
    memdir = memory_dir(args.dir)
    content, block, start = find_open_item(memdir, args.id)
    held = claim_segment(args.id, block)
    if held is None:
        # an honest no-op, like `bump` on an item already at the top. Reporting a
        # release that did not happen is what would send the caller on to work an
        # item somebody else is still holding
        print(f"T{args.id:03d} carries no claim — nothing to release")
        return
    mark = claim_mark(*claim_value(held))
    splice_item(memdir, content, block, start, clear_field_segment(block, held))
    print(f"T{args.id:03d} released — it was {mark}")


def cmd_bump(args):
    """Move an item to the TOP of the file's global order.

    Priority IS that order — no score, no hidden heuristic — so this command is
    the only way it changes: `add` puts a new item at the end, and the package
    modes take the filtered top. Top means "before the first item block", the
    mirror of what `add` does at the other end; a `##` heading the item lands
    under is cosmetic (`list` groups by the **Project:** field, never by the
    heading), and everything that is not the item's own block — frontmatter,
    headings, prose between items — is preserved verbatim.
    """
    memdir = memory_dir(args.dir)
    content, block, start = find_open_item(memdir, args.id)
    path = os.path.join(memdir, "next-steps.md")
    first = ITEM_START.search(content)
    if first and first.start() == start:
        # already there: return without writing, so a no-op bump cannot churn the
        # file's spacing (repeat it ten times and the file is still byte-identical)
        print(f"T{args.id:03d} is already at the top of the queue")
        return
    without = excise(content, block, start)
    dest = ITEM_START.search(without)
    at = dest.start() if dest else len(without)
    tail = without[at:]
    # separate it from the item it now precedes, the way `add` separates the item
    # it follows — unless the block already ends in a blank line, or there is no
    # tail to separate from
    moved = block if block.endswith("\n\n") or not tail else block + "\n"
    write_atomic(path, without[:at] + moved + tail)
    print(f"T{args.id:03d} → top of the queue")


def cmd_report(args):
    dirs = (
        sorted(
            d
            for d in (os.path.join(PROJECTS_ROOT, p, "memory") for p in os.listdir(PROJECTS_ROOT))
            if os.path.exists(os.path.join(d, "done-log.md"))
        )
        if args.all
        else [memory_dir(args.dir)]
    )
    entry = re.compile("^" + LOG_LINE + r".*(?:\n  .*)*", re.M)
    for d in dirs:
        content = read(os.path.join(d, "done-log.md"))
        if content is None:
            continue
        lines = [
            m.group(0).rstrip("\n")
            for m in entry.finditer(content)
            if not args.since or m.group(1) >= args.since
        ]
        if not lines:
            continue
        proj = os.path.basename(os.path.dirname(d))
        print(f"\n### {proj}")
        # two different axes: `###` is the memory dir (one per project repo),
        # `####` the --project tag WITHIN it — the root queue mixes several
        grouped = group_by_tag([(log_entry_tag(ln), ln) for ln in lines])
        if grouped is None:
            print("\n".join(lines))     # no tag anywhere: identical to before
            continue
        for n, (tag, entries) in enumerate(grouped):
            if n:
                print()
            print(f"#### {tag or 'no project'}")
            print("\n".join(entries))


def cmd_migrate(args):
    memdir = memory_dir(args.dir)
    path = os.path.join(memdir, "next-steps.md")
    content = read(path)
    if content is None:
        fail("next-steps.md not found in " + memdir)
    blocks = split_blocks(content)
    done = [t for k, t in blocks if k == "item-done"]
    nid = max_id(memdir)
    if done:
        log_path = os.path.join(memdir, "done-log.md")
        log = read(log_path) or DONE_LOG_TEMPLATE
        header = "## Migrado do next-steps (histórico pré-log)"
        migrated = "\n".join(t.rstrip("\n") for t in done)
        if header in log:
            log = log.replace(header, header + "\n\n" + migrated + "\n", 1)
        else:
            log = log.rstrip("\n") + f"\n\n{header}\n\nMovidos verbatim em {datetime.date.today().isoformat()}; itens carregam as próprias datas.\n\n{migrated}\n"
        write_atomic(log_path, log)
    out, dropped_prev = [], False
    for kind, text in blocks:
        if kind == "item-done":
            dropped_prev = True
            continue
        if kind == "item-open" and item_id(text) is None:
            nid += 1
            text = text.replace("- [ ] ", f"- [ ] **T{nid:03d}** — ", 1)
        if dropped_prev and out:
            # collapse surplus blank lines only at the junction left by the removal
            prev = out.pop()
            nb = len(prev) - len(prev.rstrip("\n"))
            na = len(text) - len(text.lstrip("\n"))
            if nb + na > 2:
                prev, text = prev.rstrip("\n") + "\n\n", text.lstrip("\n")
            out.append(prev)
        dropped_prev = False
        out.append(text)
    new_content = "".join(out)
    if dropped_prev:  # file ended on a removed block
        new_content = new_content.rstrip("\n") + "\n"
    write_atomic(path, new_content)
    print(f"{len(done)} [x] item(s) → done-log; IDs assigned up to T{nid:03d}")


def main():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--dir", default=argparse.SUPPRESS,
                        help="memory dir override (default: resolved from cwd)")
    p = argparse.ArgumentParser(prog="tk-queue", description=__doc__.splitlines()[0])
    p.add_argument("--dir", default=None, help=argparse.SUPPRESS)
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("list", parents=[common], help="open items with IDs")

    a = sub.add_parser("add", parents=[common], help="new item in the queue")
    a.add_argument("text")
    a.add_argument("--class", dest="classe", required=True, help="|".join(CLASSES))
    a.add_argument("--effort", required=True, help="S/M/L + wall-clock guess, e.g. 'M (~30min)'")
    a.add_argument("--risk", help="only when unsupervised execution can do damage "
                   "('none' writes no Risk line)")
    a.add_argument("--criterion", required=True,
                   help="acceptance: 'A: <command that proves it>' or 'B: user verdict'")
    a.add_argument("--deferred", help=f"why the decision could not be asked — REQUIRED by "
                   f"--class {DEFERRABLE_CLASS}, refused on every other class ('afk' in an "
                   "unattended session)")
    a.add_argument("--env", help="environment the item runs in — a name from the site "
                   "file's roster (~/.claude/tk/env), matched exactly; omit it for the "
                   "machine that owns this queue ('none' writes no Env line)")
    a.add_argument("--project", help="optional short slug tagging which project this item "
                   "belongs to, e.g. 'ambiente', 'tk' (warns on stderr if unseen in this queue)")
    a.add_argument("--source", help="origin (default: today's date)")
    a.add_argument("--force", action="store_true")

    d = sub.add_parser("done", parents=[common], help="conclude: move the item to the done-log")
    d.add_argument("id", type=parse_id)
    d.add_argument("--how", required=True, help="outcome + pointer: 'PR #82', 'commit abc123', '[[slug]]'")
    d.add_argument("--summary", help="replaces the item text on the log line")
    d.add_argument("--note", help="extra substance when there is NO pointer (the line is the only record)")
    d.add_argument("--force", action="store_true", help="raise the field ceiling")

    c = sub.add_parser("cancel", parents=[common], help="discard: move the item to the done-log as DESCARTADO")
    c.add_argument("id", type=parse_id)
    c.add_argument("--why", required=True)
    c.add_argument("--summary")
    c.add_argument("--note")
    c.add_argument("--force", action="store_true", help="raise the field ceiling")

    e = sub.add_parser("edit", parents=[common], help="edit fields of an open item")
    e.add_argument("id", type=parse_id)
    e.add_argument("--text")
    e.add_argument("--class", dest="classe")
    e.add_argument("--effort")
    e.add_argument("--risk", help="new Risk line, or 'none' to DELETE the field "
                   "(re-triage of an obsolete Risk)")
    e.add_argument("--criterion")
    e.add_argument("--deferred", help=f"justification demanded by `--class "
                   f"{DEFERRABLE_CLASS}`; it is dropped by leaving that class, never by "
                   "'none'")
    e.add_argument("--env", help="new environment (a name from the site file's roster), "
                   "or 'none' to DELETE the field — the item then runs wherever the "
                   "queue does")
    e.add_argument("--project", help="assign/change the project tag")
    e.add_argument("--force", action="store_true")

    cl = sub.add_parser("claim", parents=[common],
                        help="take an item, so a sibling session does not work it too")
    cl.add_argument("id", type=parse_id)
    cl.add_argument("--as", dest="owner", required=True,
                    help="who is taking it — a session or host label (letters, digits, "
                         "'.', '-', '_', at most 32 chars, no spaces): it is written "
                         "beside the moment of the claim and both are read back")

    rl = sub.add_parser("release", parents=[common],
                        help="hand a claimed item back to the queue without closing it")
    rl.add_argument("id", type=parse_id)

    b = sub.add_parser("bump", parents=[common],
                       help="move an item to the top of the queue's global order")
    b.add_argument("id", type=parse_id)

    r = sub.add_parser("report", parents=[common], help="done-log entries")
    r.add_argument("--since", help="YYYY-MM-DD")
    r.add_argument("--all", action="store_true", help="sweeps every project")

    sub.add_parser("migrate", parents=[common],
                   help="move legacy [x] items to the done-log and assign IDs to open ones")

    args = p.parse_args()
    handler = {
        "list": cmd_list,
        "add": cmd_add,
        "done": cmd_done,
        "cancel": cmd_cancel,
        "edit": cmd_edit,
        "claim": cmd_claim,
        "release": cmd_release,
        "bump": cmd_bump,
        "report": cmd_report,
        "migrate": cmd_migrate,
    }[args.cmd]
    if args.cmd not in READERS:
        memdir = memory_dir(args.dir)
        # Which queue is being written is INFERRED — from --dir, or from the cwd
        # when it is absent — and an inference nobody sees is an inference nobody
        # checks. A caller whose cwd is not where they think (the agent's shell
        # keeps its cwd between calls) edits a homonymous item in ANOTHER project's
        # queue and is told "T019 updated", which reads as success. Printing the
        # resolved dir is what makes that visible without a flag to remember —
        # stderr, so it never contaminates stdout that a caller parses, and BEFORE
        # the work, so a command that then fails or blocks on the lock has still
        # said where it was aiming.
        print(f"tk-queue: queue: {memdir}", file=sys.stderr)
        # taken BEFORE the handler's first read, released after its last write:
        # a lock around the write alone would still let a stale snapshot win
        with queue_lock(memdir):
            handler(args)
    else:
        handler(args)


if __name__ == "__main__":
    main()
