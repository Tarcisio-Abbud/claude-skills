#!/usr/bin/env python3
"""tk-dossier — the two facts of a merge dossier that must not be recalled.

A **merge dossier** is what a human reads INSTEAD of four browser tabs, and it
exists because a trail can be complete and still unreadable: the verdict cites
"recommendation 1" and the sentence that names lives in another artefact. What a
dossier is, and its five sections, is `../reference/dossier.md`; this script
owns the two that a writer working from memory gets wrong.

POINTERS (`pointers`) — what this subcommand GUARANTEES, which is the half a
caller may rely on without reading further: nothing is OMITTED, because the
harvest is exhaustive over a vocabulary it prints, and omission is the failure a
closing session actually commits; and nothing is GUESSED, because it refuses to
decide WHICH list a cited number belongs to. Markdown gives an enumerated list
no name, so that decision can only be read out of the prose nearby, and two
review rounds measured what such a reading produces — `como 4`, from "quero
safe-to-merge como 4 vereditos", bound to an unrelated sentence at exit 0. The
caller declares the list with `--list`; the script quotes what it was pointed
at. A dossier that invents the sentence behind a number is worse than the four
tabs it replaced — the tabs were at least true.

COLLISIONS (`collisions`) — what it GUARANTEES: two branches are merged for
real, into a tree nobody keeps, so a pair that cannot both land is named before
either does. It asks no forge field, for the reason `../reference/dossier.md`
gives.

HOW EITHER IS DRIVEN, and what its output means, is in
`../reference/dossier.md`, which owns that description. This docstring owns what
the script promises; keeping the two apart is what stops one correction landing
in three places out of four, which it did, twice.

NEITHER SUBCOMMAND TOUCHES THE NETWORK. Fetching the PR body and the issue it
closes is the caller's job, with the `gh` it already runs; the texts arrive here
as files. So this script behaves the same on a machine with no forge CLI, and
the suite proves both subcommands without one.

EXIT CODES are the same three everywhere: 0 nothing is outstanding — every
pointer harvested resolved against a declared list, every pair merged clean —,
1 the answer carries something the dossier must state (an unresolved pointer,
a colliding pair), 2 the run itself could not be made. 1 is a finding, never a
crash — a caller that treats it as one drops exactly the material this script
exists to surface. A first `pointers` run declares nothing, so every pointer it
HARVESTS comes back unresolved and it ends 1; a trail citing nothing this
vocabulary carries harvests none and ends 0, with the answer saying so.
"""

import argparse
import json
import os
import re
import subprocess
import sys
import textwrap
import unicodedata

EXIT_OK = 0
EXIT_FINDING = 1
EXIT_FAILED = 2


def fail(msg):
    """Stop with code 2. Distinct from a finding: the run did not happen."""
    print(f"tk-dossier: {msg}", file=sys.stderr)
    sys.exit(EXIT_FAILED)


def read_text(label, path):
    """The file's lines, or a stop that names what could not be read.

    Every guard here has cost a defect somewhere in this repo: a path that is a
    directory, a byte that is not UTF-8, and a byte-order mark glued to the
    first character all reach a hand-written reader as something other than an
    exception at the parse."""
    if not os.path.isfile(path):
        fail(f"{label}: {path} is not a regular file. The dossier reads texts "
             "the caller has already fetched — a PR body, an issue body, a "
             "comment — one file each.")
    try:
        with open(path, encoding="utf-8-sig") as f:
            text = f.read()
    except (OSError, UnicodeDecodeError) as e:
        fail(f"{label}: {path} cannot be read: {e}")
    return text.replace("\ufeff", "").splitlines()


def labelled(arg):
    """`label=path`, or a bare path whose basename becomes its own label.

    The label is what every line of the report cites, so a caller naming its
    sources `154` and `154-comments` gets a dossier whose addresses a human can
    follow back. Split on the FIRST `=`: a path may contain one, a label may
    not."""
    label, sep, path = arg.partition("=")
    if not sep:
        return os.path.basename(arg) or arg, arg
    if not label or not path:
        fail(f"{arg!r} is neither a path nor `label=path`.")
    return label, path


def unaccent(s):
    """Accents dropped, case KEPT: the noun of a pointer is matched without
    caring about either, while its index `A` must stay distinct from an `a` that
    is just a word in prose."""
    return "".join(c for c in unicodedata.normalize("NFKD", s)
                   if not unicodedata.combining(c))


def unaccent_indexed(s):
    """The same folding, plus the index in `s` each folded character came from.

    Matching happens on the folded line and the REPORT quotes the original, so
    the map is what keeps "Recomendação 4" from being handed back to a
    Portuguese reader as "Recomendacao 4". Dropping a combining mark shortens
    the string, so an offset taken from the folded line addresses the wrong
    character in the original as soon as one accent precedes it."""
    folded, origin = [], []
    for i, ch in enumerate(s):
        for c in unicodedata.normalize("NFKD", ch):
            if not unicodedata.combining(c):
                folded.append(c)
                origin.append(i)
    return "".join(folded), origin


# The pointer vocabulary. A family is one concept and the spellings that reach
# it; the report prints the families it searched, because a harvest is only
# exhaustive over words it knows and a reader must be able to see which those
# were. `--noun` extends it for a trail that says "requisito 4". An unknown noun
# is INVISIBLE here — not unresolved, invisible — and nothing in this script
# prevents that; what it does instead is never claim otherwise, which is why the
# empty answer speaks about the vocabulary and never about the text.
POINTER_NOUNS = {
    "recomendacao": ("recomendacao", "recomendacoes", "recommendation", "recommendations"),
    "item": ("item", "itens", "items"),
    "criterio": ("criterio", "criterios", "criterion", "criteria"),
    "decisao": ("decisao", "decisoes", "decision", "decisions"),
    "bloco": ("bloco", "blocos", "block", "blocks"),
    "secao": ("secao", "secoes", "section", "sections"),
}

# what may sit between a noun and its index: whitespace, and optionally an
# ordinal marker (`nº`, `no.`, `n°`) — the Portuguese trails here use all three
SEPARATOR = r"[ \t]+(?:n[o\u00ba\u00b0]\.?[ \t]*)?"

FENCE_RE = re.compile(r"^\s*(```|~~~)")
LIST_RE = re.compile(r"^(?P<indent>[ \t]*)(?P<marker>\d{1,3}|[A-Za-z])[.)][ \t]+(?P<text>\S.*)$")
TABLE_ROW_RE = re.compile(r"^[ \t]*\|(?P<cells>.*)\|[ \t]*$")
# what an index looks like, wherever an index is read
INDEX = r"\d{1,3}|[A-Z]"
HEADING_RE = re.compile(r"^[ \t]*#{1,6}[ \t]")
WORD_RE = re.compile(r"[A-Za-z]+")


def citation_re(vocabulary):
    """Noun-then-index, the shape a citation takes in every trail measured here.

    The index is one to three digits or ONE capital: a fourth digit means a
    year or a token count, and a lowercase letter after a noun is ordinary
    prose ("item a ser feito"). An ordinal marker may sit between the two —
    `achado nº 1` is one citation, and reading it as none is the silent
    omission this whole subcommand exists to prevent.

    The alternation is sorted so the pattern is byte-identical run to run; the
    ORDER does not decide the match, because the mandatory separator after the
    noun forces the engine back to the spelling that fits (`recomendacoes 3`
    resolves the same either way — measured, not assumed)."""
    words = sorted({w for ws in vocabulary.values() for w in ws},
                   key=lambda w: (-len(w), w))
    alt = "|".join(re.escape(w) for w in words)
    return re.compile(rf"(?i:\b(?P<noun>{alt}))"
                      rf"{SEPARATOR}(?P<idx>\d{{1,3}}|[A-Z])\b")


def strip_fences(lines):
    """Fenced code BLANKED, never removed.

    Fenced text is quoted, not written: a `1.` inside one is not a list entry
    and an "item 3" inside one is not a citation — a dossier that harvested
    from its own worked example would cite the example. Blanking rather than
    deleting is what keeps every line number this script prints equal to the
    line number in the file."""
    out, fence = [], None
    for line in lines:
        opening = FENCE_RE.match(line)
        if fence is None:
            if opening:
                fence = opening.group(1)
                out.append("")
                continue
            out.append(line)
            continue
        out.append("")
        if line.strip().startswith(fence):
            fence = None
    return out


def context_of(lines, start):
    """The heading and lead-in above a block, SHOWN so a caller can choose it.

    This text is never matched against anything. It used to be: a block was
    tagged with every pointer family whose word appeared anywhere in it, and
    that inference produced a confident, silent, wrong binding every time a
    word was used in ordinary prose rather than as the list's name — `como 4`
    from "quero safe-to-merge como 4 vereditos", and `seção 3` from "Seção reescrita
    na PR #156" above a list of DECISIONS. Markdown carries no field saying
    what a list is called, so any reading of the prose around one is a guess,
    and a guess is exactly what this script may not make. The caller declares
    the list with `--list`; this string is here to make that choice cheap."""
    heading, lead, seen_text = "", [], False
    for i in range(start - 1, -1, -1):
        stripped = lines[i].strip()
        if not stripped:
            if seen_text:
                break            # the paragraph ended; only the heading is left
            continue
        if HEADING_RE.match(lines[i]):
            heading = stripped
            break
        lead.append(stripped)
        seen_text = True
    if seen_text:                # the heading sits above the paragraph we took
        for i in range(start - 1 - len(lead), -1, -1):
            if HEADING_RE.match(lines[i]):
                heading = lines[i].strip()
                break
    # REVERSED: the walk above goes upward, so `lead` holds the paragraph's
    # last line first. Harmless while this string only fed a word-set match;
    # fatal the moment it became the text a caller chooses a list BY, which is
    # what it is now — a scrambled paragraph makes the cheap choice expensive
    return heading + " " + " ".join(reversed(lead))


def index_after(first, offset):
    """The index a renderer SHOWS for the entry `offset` places into a run.

    Markdown numbers from the first marker and increments — `1. 1. 1.` renders
    1, 2, 3, and that idiom is everywhere in these trails. Reading the markers
    literally would give a list of three entries all called 1, and every
    pointer past the first would come back unresolved against a source that
    plainly has the sentence."""
    if first.isdigit():
        return str(int(first) + offset)
    return chr(ord(first.upper()) + offset)


class Block:
    """One enumerated run in a source: what it is called, and what it says."""

    def __init__(self, kind, line, context, entries, skipped=0):
        self.kind = kind
        self.line = line
        self.context = context
        # rows this block could not read as entries. Reported, because a span
        # that is short by a parsing artifact reads exactly like a span that is
        # short because the list really is
        self.skipped = skipped
        # index -> (line the entry starts on, its statement). The ENTRY's line,
        # never the block's: a report that sends every pointer of a six-entry
        # list to the same line has not been followed back by anyone
        self.entries = entries

    def span(self):
        keys = list(self.entries)
        return f"{keys[0]}–{keys[-1]}" if len(keys) > 1 else keys[0]


def list_blocks(lines):
    """Ordered-list runs, with their continuation lines folded in.

    A run needs TWO entries to be a list: one `A. something` alone is a
    sentence, and binding a pointer to it would be the guess this script
    refuses. Continuation lines are joined because an entry's first line is
    routinely half its sentence, and half a sentence beside a number reads as
    an answer while telling the reader nothing."""
    blocks, i = [], 0
    while i < len(lines):
        opening = LIST_RE.match(lines[i])
        if not opening:
            i += 1
            continue
        indent, first = opening.group("indent"), opening.group("marker")
        start, entries, texts, at = i, [], [opening.group("text")], i + 1
        i += 1
        held = 0
        while i < len(lines):
            entry = LIST_RE.match(lines[i])
            if entry and entry.group("indent") == indent:
                entries.append((at, " ".join(texts)))
                texts, at = [entry.group("text")], i + 1
                held = 0
                i += 1
                continue
            if not lines[i].strip():
                held += 1
                i += 1
                continue
            deeper = len(lines[i]) - len(lines[i].lstrip())
            if deeper > len(indent) and held <= 1:
                texts.append(lines[i].strip())
                held = 0
                i += 1
                continue
            break
        entries.append((at, " ".join(texts)))
        if len(entries) >= 2:
            keyed = {index_after(first, n): e for n, e in enumerate(entries)}
            blocks.append(Block("list", start + 1, context_of(lines, start), keyed))
    return blocks


def cells_of(row):
    return [c.strip() for c in TABLE_ROW_RE.match(row).group("cells").split("|")]


def table_blocks(lines):
    """Markdown tables whose first column is a bare index.

    A contract in this repo is as often a table as a list — `| 1 | Stats line |`
    — and "block 4" points into one. Only a first cell that is NOTHING but an
    index counts: a column of prose that happens to start with a number is not
    an enumeration."""
    blocks, i = [], 0
    while i < len(lines):
        if not TABLE_ROW_RE.match(lines[i]):
            i += 1
            continue
        start, rows = i, []
        while i < len(lines) and TABLE_ROW_RE.match(lines[i]):
            rows.append(lines[i])
            i += 1
        # TWO passes, because a real review table writes `| 1 GRAVE |` in the
        # same column as `| 3 |`, and reading only the bare cells reported that
        # table as running 3–8 when it runs 1–8. The under-report is worse than
        # it looks: the block then loses coverage points to a PARSING artifact,
        # and a wrong list outranks it on a score the reader trusts.
        #
        # An annotated cell counts only once the column has PROVED it is an
        # index column, by carrying at least one bare index. That proof comes
        # from the table itself — no guess about what a first column means, and
        # no way for a column of prose to be read as one.
        bare = [cells_of(row)[0].strip("*_ `") for row in rows]
        proved = any(re.fullmatch(INDEX, k) for k in bare)
        # a header row is not a row that failed to be an entry: it is the row
        # that names the columns, and counting it as missed would put a
        # permanent "1 row(s) not read" on every well-formed table
        header = 1 if len(rows) > 1 and all(
            re.fullmatch(r":?-{2,}:?", c) for c in cells_of(rows[1]) if c) else 0
        keyed, skipped = {}, 0
        for offset, row in enumerate(rows):
            cells = cells_of(row)
            # the separator row (`|---|---|`) needs no case of its own: `---`
            # is not an index, so the tests below already drop it
            first = cells[0].strip("*_ `")
            if len(cells) < 2:
                continue
            # one branch, not two: a bare `1` is the annotated case with an
            # empty annotation, and a second branch for it would be code no
            # input can reach — which is code that quietly stops being right
            indexed = proved and re.match(rf"({INDEX})\b(.*)", first)
            if indexed:
                key, rest = indexed.group(1), indexed.group(2).strip("*_ `-—– ")
            else:
                if first and offset >= header and not re.fullmatch(r":?-{2,}:?", first):
                    skipped += 1
                continue
            keyed.setdefault(key, (start + offset + 1,
                                   " · ".join([c for c in ([rest] if rest else [])
                                               + list(cells[1:]) if c])))
        if len(keyed) >= 2:
            # the header row is INSIDE the block, so context_of cannot see it —
            # and a table names its own subject there (`| # | Block | Marker |`)
            # more reliably than any prose above it does
            context = context_of(lines, start) + " " + rows[0]
            blocks.append(Block("table", start + 1, context, keyed, skipped))
    return blocks


def blocks_of(lines):
    lines = strip_fences(lines)
    return list_blocks(lines) + table_blocks(lines)


class Pointer:
    def __init__(self, noun, family, index):
        self.noun, self.family, self.index = noun, family, index
        self.citations = []      # (label, line, text, how many times on it)
        self.source = self.line = self.statement = self.reason = None

    def cite(self, label, line, text):
        for n, (seen, where, quoted, times) in enumerate(self.citations):
            if (seen, where) == (label, line):
                # a long table row states the same pointer three times; three
                # identical quotes of it read as three findings
                self.citations[n] = (seen, where, quoted, times + 1)
                return
        self.citations.append((label, line, text, 1))

    @property
    def resolved(self):
        return self.statement is not None


def harvest(citing, vocabulary):
    """Every citation in the citing texts, in the order they are first cited.

    Grouped by (family, index): a trail cites the same recommendation in the
    body and again in the verdict comment, and a dossier owes the reader one
    resolved sentence, not the same one twice. Every site is kept, because
    "where was this claimed" is the next question a reader asks."""
    pattern = citation_re(vocabulary)
    spelling = {w: fam for fam, ws in vocabulary.items() for w in ws}
    found = {}
    for label, lines in citing:
        for n, line in enumerate(strip_fences(lines), 1):
            folded, origin = unaccent_indexed(line)
            for m in pattern.finditer(folded):
                noun = m.group("noun")
                spelled = line[origin[m.start("noun")]:origin[m.end("noun") - 1] + 1]
                family = spelling[noun.lower()]
                key = (family, m.group("idx"))
                if key not in found:
                    found[key] = Pointer(spelled, family, m.group("idx"))
                found[key].cite(label, n, line.strip())
    return list(found.values())


def declared(arg, sources):
    """`family=source:line` — the caller naming which list a family means.

    This replaces an inference that could not be made honestly. Markdown gives
    a list no name, so the tool asked the prose around it and was wrong in a
    way no reader could see. Now the answer comes from whoever read the trail,
    and the tool's job shrinks to what it can guarantee: quoting the right
    entry of the list it was pointed at."""
    family, sep, where = arg.partition("=")
    source, colon, line = where.rpartition(":")
    if not (sep and colon) or not line.isdigit() or not family:
        fail(f"--list {arg!r}: the shape is `family=source:line`, where `source` "
             "is a --source label and `line` is the line its list starts on. "
             "Run without --list to see what can be declared.")
    known = dict(sources)
    if source not in known:
        fail(f"--list {arg!r}: `{source}` is not one of the sources given "
             f"({', '.join(known) or 'none'}).")
    for block in known[source]:
        if block.line == int(line):
            return family.lower(), source, block
    at = ", ".join(str(b.line) for b in known[source]) or "none at all"
    fail(f"--list {arg!r}: `{source}` has no enumerated list starting on line "
         f"{line}. It has lists on line(s): {at}.")


def bind(pointer, declarations):
    """Quote the entry, or say why there is nothing to quote.

    Two outcomes and no third. Either the caller declared which list this
    family means and the entry exists, or the report says which of those two
    is missing. Nothing here reads the prose around a list, so nothing here
    can prefer the wrong artefact."""
    if pointer.family not in declarations:
        # this text lands in the dossier a human reads, so it names what is
        # missing and says nothing about what another part of the report shows
        pointer.reason = (f"no list is declared for `{pointer.family}`: pass "
                          f"`--list {pointer.family}=<source>:<line>`")
        return
    source, block = declarations[pointer.family]
    if pointer.index in block.entries:
        pointer.line, pointer.statement = block.entries[pointer.index]
        pointer.source = source
    else:
        pointer.reason = (f"the declared {block.kind} at `{source}`:{block.line} "
                          f"runs {block.span()}, so {pointer.index} is not one of "
                          "its entries — either the trail cites a number that "
                          "does not exist, or the declared list is the wrong one")


def shorten(text, width=150):
    text = " ".join(text.split())
    return text if len(text) <= width else text[:width - 1].rstrip() + "…"


def wrap(text, indent):
    """A statement, printed whole and readable.

    Whole because truncating one cut a real entry a clause before the exception
    that qualified it; wrapped because printing it whole produced 500-character
    lines on real trails. The two are not in tension — the cap belongs on the
    LINE, never on the text."""
    # `break_long_words` and `break_on_hyphens` OFF: a URL, a branch name or a
    # path is one token, and splitting it mid-word leaves the reader no way to
    # tell a wrap from a hyphen that was really there. A line may overrun; a
    # mangled identifier may not. The `split`/`join` is load-bearing too —
    # `textwrap` replaces each whitespace CHARACTER and never collapses a run
    return textwrap.fill(" ".join(text.split()), width=96,
                         initial_indent=indent, subsequent_indent=" " * len(indent),
                         break_long_words=False, break_on_hyphens=False)


def in_order(indexes):
    """Indexes as a reader counts them: 2 before 10, never after.

    They are STRINGS, because that is what the harvest captured, and sorting
    strings put `1, 10, 11, 12, 2` on the line a reader scans to see what a
    trail cites. Digits sort as numbers, letters after them as letters."""
    return sorted(indexes, key=lambda i: (not i.isdigit(),
                                          int(i) if i.isdigit() else 0, i))


def offering(pointers, sources, declarations):
    """The lists that could answer, PER undeclared family, best first.

    Per family, and that word is the whole fix. Pooling every family's indexes
    into one set credited a list for holding a number some OTHER family cited:
    on a real trail the recommendations list scored a perfect 2 of 2 for family
    `item`, whose statements live in a file that was never passed. A caller
    trusting the top score got the silent wrong binding this subcommand exists
    to prevent.

    A list is offered when it holds one of that family's cited numbers, and
    ordered by how many it holds — arithmetic, not a reading of the prose
    around it. Ties keep the order the sources were given in, so the answer is
    stable run to run.

    ONE computation, and both renderers read it. They were two branches once,
    each free to drift, and the JSON one kept the unfiltered, unordered list
    for a whole round after the text one stopped showing it."""
    # no `not p.resolved` test: `bind` resolves a pointer only when its family
    # was declared, so excluding declared families already excludes every
    # resolved one. A condition no input can falsify is one no mutant can kill
    families = sorted({p.family for p in pointers
                       if p.family not in declarations})
    offer = {}
    for family in families:
        wanted = {p.index for p in pointers if p.family == family}
        holding = [(label, block, wanted & set(block.entries))
                   for label, blocks in sources for block in blocks]
        offer[family] = (wanted, sorted((h for h in holding if h[2]),
                                        key=lambda h: -len(h[2])))
    return offer


def report_pointers(pointers, vocabulary, sources, declarations, as_json):
    resolved = [p for p in pointers if p.resolved]
    unresolved = [p for p in pointers if not p.resolved]
    offer = offering(pointers, sources, declarations)
    if as_json:
        print(json.dumps({
            "vocabulary": sorted(vocabulary),
            "sources": [label for label, _ in sources],
            "declarations": {family: {"source": source, "line": block.line}
                             for family, (source, block) in declarations.items()},
            "counts": {"cited": len(pointers), "resolved": len(resolved),
                       "unresolved": len(unresolved)},
            "pointers": [{
                "noun": p.noun, "family": p.family, "index": p.index,
                "resolved": p.resolved, "source": p.source, "line": p.line,
                "statement": p.statement, "reason": p.reason,
                "citations": [{"source": s, "line": n, "text": t, "times": k}
                              for s, n, t, k in p.citations],
            } for p in pointers],
            "offering": {family: [
                {"source": label, "line": b.line, "kind": b.kind,
                 "span": b.span(), "skipped": b.skipped,
                 "holds": in_order(covers), "of": len(wanted),
                 "context": " ".join(b.context.split())}
                for label, b, covers in offered]
                for family, (wanted, offered) in offer.items()},
        }, ensure_ascii=False, indent=2))
        return

    print(f"## pointers — {len(pointers)} cited · {len(resolved)} resolved · "
          f"{len(unresolved)} unresolved\n")
    print("vocabulary searched: " + ", ".join(sorted(vocabulary)))
    print("sources: " + (", ".join(label for label, _ in sources) or "(none given)"))
    print("lists declared: " + (", ".join(
        f"{family}={source}:{block.line}"
        for family, (source, block) in sorted(declarations.items())) or "(none)") + "\n")
    if not pointers:
        # NEVER "this text cites nothing": that is a claim about the TEXT, and
        # the only claim a harvest can make is about the words it was given
        print("Nothing matched the vocabulary above. That is not the same as "
              "\"this text cites nothing\":\na trail numbering its statements "
              "under another noun is invisible to this vocabulary,\nand "
              "`--noun <word>` is what makes it visible.\n")
    for p in pointers:
        print(("RESOLVED    " if p.resolved else "UNRESOLVED  ") + f"{p.noun} {p.index}")
        if p.resolved:
            print(wrap(p.statement, f"            says   {p.source}:{p.line}  "))
        else:
            print(wrap(p.reason, "            why    "))
        for label, n, text, times in p.citations:
            seen = f" (×{times})" if times > 1 else ""
            print(f"            cited  {label}:{n}{seen}  {shorten(text, 110)}")

    if offer:
        print("\n## the lists that could answer\n")
        print("Nothing below is chosen for you: which list the trail MEANS is "
              "not written\nanywhere in Markdown, so reading the prose around "
              "one would be a guess, and a\nguess that reads like an answer is "
              "the worst thing this script could print.")
    for family, (wanted, offered) in offer.items():
        print(f"\n`{family}`, cited as {', '.join(in_order(wanted))}\n")
        for label, b, covers in offered:
            missed = (f", {b.skipped} row(s) not read as entries"
                      if b.skipped else "")
            print(f"{label}:{b.line}  {b.kind}, entries {b.span()}{missed} — "
                  f"holds {len(covers)} of the {len(wanted)} cited")
            print(wrap(b.context or "(no heading or lead-in above it)", " " * 12))
        if offered:
            print(f"            then: --list {family}=<source>:<line>")
        else:
            # `declared` refuses a source that was not given, so telling the
            # caller to declare one here is an instruction they cannot carry out
            print(wrap("no source given holds a list with any of those numbers. "
                       "Add the artefact that carries them as another "
                       "`--source`, or carry these pointers into the dossier "
                       "as unresolved.", " " * 12))
    if unresolved:
        print(f"\n{len(unresolved)} pointer(s) did not resolve. Section 1 of the "
              "dossier carries them AS\nunresolved, named — dropping one leaves "
              "a number in the trail with nothing behind it.")


def cmd_pointers(args):
    vocabulary = dict(POINTER_NOUNS)
    for word in args.noun or ():
        # every spelling of ONE family, comma-separated: a label reads
        # `## Requisitos` while the trail cites `requisito 4`, and a family
        # holding only the singular answers neither the label nor the plural
        spellings = tuple(unaccent(w).lower() for w in word.split(",") if w.strip())
        if not spellings or not all(WORD_RE.fullmatch(w) for w in spellings):
            fail(f"--noun {word!r}: one word of letters, or several separated "
                 "by commas — every spelling of the same noun.")
        vocabulary[spellings[0]] = spellings

    citing = [(label, read_text(label, path))
              for label, path in map(labelled, args.citing)]
    sources = [(label, blocks_of(read_text(label, path)))
               for label, path in map(labelled, args.source or ())]
    declarations = {}
    for arg in args.list or ():
        family, source, block = declared(arg, sources)
        declarations[family] = (source, block)

    pointers = harvest(citing, vocabulary)
    for pointer in pointers:
        bind(pointer, declarations)
    report_pointers(pointers, vocabulary, sources, declarations, args.json)
    return EXIT_FINDING if any(not p.resolved for p in pointers) else EXIT_OK


def git(repo, *argv):
    try:
        return subprocess.run(["git", "-C", repo, *argv],
                              capture_output=True, text=True)
    except OSError as e:
        fail(f"git could not be run: {e}")


def conflicts_of(out):
    """The conflicted paths and the messages, read from `merge-tree`'s output.

    TWO readings, because either alone has a way of being empty while the merge
    really did conflict: the stage entries (`<mode> <oid> <stage>\\t<path>`,
    stage 1/2/3), which are the machine-readable half, and the `CONFLICT (...)`
    message lines, which name kinds that never reach a stage entry at all. A
    merge that failed with neither is not read as clean — see `measure`."""
    paths, messages = [], []
    for line in out.splitlines():
        stage = re.match(r"^\d{6} [0-9a-f]{4,64} ([123])\t(.*)$", line)
        if stage:
            if stage.group(2) not in paths:
                paths.append(stage.group(2))
        elif line.startswith("CONFLICT ("):
            messages.append(line)
            named = re.search(r"Merge conflict in (.+)$", line)
            if named and named.group(1) not in paths:
                paths.append(named.group(1))
    return paths, messages


def measure(repo, a, b):
    """One pair, merged for real into a tree nobody keeps."""
    run = git(repo, "merge-tree", "--write-tree", a, b)
    if run.returncode == 0:
        return [], []
    paths, messages = conflicts_of(run.stdout)
    if not paths and not messages:
        # `merge-tree` exits 1 for a conflict AND for a merge it could not even
        # attempt — an unknown flag on a git older than 2.38, a ref that
        # disappeared between the check and here. Reading that as "clean" is
        # the exact lie this subcommand was written to stop telling
        fail(f"`git merge-tree --write-tree {a} {b}` failed without naming a "
             f"conflict, so nothing was measured: "
             f"{(run.stderr or run.stdout).strip() or 'no output'}")
    return paths, messages


def cmd_collisions(args):
    repo = args.repo
    if git(repo, "rev-parse", "--git-dir").returncode != 0:
        fail(f"{repo} is not a git repository.")
    for ref in args.refs:
        if git(repo, "rev-parse", "--verify", "--quiet", ref + "^{commit}").returncode != 0:
            fail(f"{ref} names no commit in {repo}. Branches of open PRs live "
                 "under `origin/` until they are checked out — fetch first.")

    if len(args.refs) < 2:
        message = (f"one branch named ({args.refs[0]}), so there is no pair to "
                   "measure — a lone PR collides with nobody")
        print(json.dumps({"pairs": [], "note": message}, ensure_ascii=False, indent=2)
              if args.json else f"## collisions — {message}")
        return EXIT_OK

    pairs = []
    for i, a in enumerate(args.refs):
        for b in args.refs[i + 1:]:
            paths, messages = measure(repo, a, b)
            pairs.append({"a": a, "b": b, "conflicts": bool(paths or messages),
                          "paths": paths, "messages": messages})

    hit = [p for p in pairs if p["conflicts"]]
    if args.json:
        print(json.dumps({"repo": repo, "pairs": pairs,
                          "counts": {"measured": len(pairs), "colliding": len(hit)}},
                         ensure_ascii=False, indent=2))
    else:
        print(f"## collisions — {len(pairs)} pair(s) merged by "
              f"`git merge-tree --write-tree`, {len(hit)} colliding\n")
        for pair in pairs:
            if not pair["conflicts"]:
                print(f"clean     {pair['a']} × {pair['b']}")
                continue
            print(f"COLLIDES  {pair['a']} × {pair['b']}")
            for path in pair["paths"]:
                print(f"          {path}")
            for message in pair["messages"]:
                print(f"          {message}")
        print("\nMeasured pair by pair, by merging each pair for real. Merge "
              "order does not avoid a\ncollision — it only chooses which PR pays "
              "for it. Why no forge field answers this\nis in "
              "reference/dossier.md, which owns that description.")
    return EXIT_FINDING if hit else EXIT_OK


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="tk-dossier",
        description="The measured facts of a merge dossier: the pointers a "
                    "trail cites by number, and whether two open branches can "
                    "both land. The dossier itself is ../reference/dossier.md.")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("pointers", help="resolve every citation-by-number in a trail")
    p.add_argument("--citing", action="append", required=True, metavar="[LABEL=]PATH",
                   help="a text that CITES by number (the PR body, a verdict "
                        "comment). Repeatable.")
    p.add_argument("--source", action="append", metavar="[LABEL=]PATH",
                   help="a text that CARRIES the numbered statements (the issue "
                        "body, a spec). Repeatable. What the order does, and "
                        "everything else this prints, is described in "
                        "../reference/dossier.md, which owns it.")
    p.add_argument("--list", action="append", metavar="FAMILY=SOURCE:LINE",
                   help="which enumerated list a pointer family means — "
                        "`--list recomendacao=154:34`. Run without it to see "
                        "what can be declared. Repeatable.")
    p.add_argument("--noun", action="append", metavar="WORD[,WORD...]",
                   help="one more pointer noun, with every spelling that reaches "
                        "it — `--noun requisito,requisitos`. Repeatable.")
    p.add_argument("--json", action="store_true", help="the same answer, for a reader")
    p.set_defaults(run=cmd_pointers)

    c = sub.add_parser("collisions", help="merge every pair of branches for real")
    c.add_argument("refs", nargs="+", metavar="REF",
                   help="the branches of the open PRs, usually `origin/<branch>`")
    c.add_argument("--repo", default=".", metavar="DIR", help="the repository (default: .)")
    c.add_argument("--json", action="store_true", help="the same answer, for a reader")
    c.set_defaults(run=cmd_collisions)

    args = parser.parse_args(argv)
    return args.run(args)


if __name__ == "__main__":
    sys.exit(main())
