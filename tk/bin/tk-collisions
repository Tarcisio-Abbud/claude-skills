#!/usr/bin/env python3
"""tk-collisions — can these open branches all land?

Merges every PAIR of refs for real, into a tree nobody keeps, and names the
pair that cannot both land before either does.

WITH `--against`, it answers the harder question, the one a merge gate asks:
once THIS branch has landed, does each of the others still land GREEN? A test
one branch adds can grade a file another branch edits while every merge is
textually clean — the collision is SEMANTIC, and no merge sees it. So the
union `merge(merge(--base, --against), other)` is built, checked out into a
TEMPORARY detached worktree, and `--suite` is run in it. That worktree is the
one thing this script materialises, it lives only while the suite runs, and a
`finally` removes it whether the suite came back green, red or not at all.

WHY NOT ASK THE FORGE: `mergeable`/`mergeStateStatus` answer only "does this PR
merge into its base", which is blind between two PRs. Two branches can each be
green against `main` and still conflict with each other.

NO NETWORK. The refs must already be local — branches of open PRs live under
`origin/` until fetched.

EXIT CODES: 0 nothing collides · 1 a FINDING, not a crash — a pair that
conflicts textually, or a union whose suite came back red · 2 the run could
not be made.
"""

import argparse
import json
import re
import shutil
import subprocess
import sys
import tempfile

EXIT_OK = 0
EXIT_FINDING = 1
EXIT_FAILED = 2

# The last lines of a red suite, carried into the answer. Enough for the
# failure header, the assertion and unittest's own footer; a whole suite log
# would drown the pair it belongs to.
SUITE_TAIL_LINES = 20

# The union commit belongs to the tool, not to whoever runs it — and pinning
# the identity here keeps a repository with no `user.email` configured from
# failing a run that never asked for one.
IDENTITY = ("-c", "user.name=tk-collisions",
            "-c", "user.email=tk-collisions@invalid")


def fail(msg):
    """Stop with code 2. Distinct from a finding: the run did not happen."""
    print(f"tk-collisions: {msg}", file=sys.stderr)
    sys.exit(EXIT_FAILED)


def git(repo, *argv):
    try:
        return subprocess.run(["git", "-C", repo, *argv],
                              capture_output=True, text=True)
    except OSError as e:
        fail(f"git could not be run: {e}")


def conflicts_of(out):
    """The conflicted paths and the messages, read from `merge-tree`'s output.

    TWO readings, because either alone has a way of being empty while the merge
    really did conflict: the stage entries (`<mode> <oid> <stage>\\t<path>`,
    stage 1/2/3), and the `CONFLICT (...)` message lines, which name kinds that
    never reach a stage entry at all."""
    paths, messages = [], []
    for line in out.splitlines():
        stage = re.match(r"^\d{6} [0-9a-f]{4,64} ([123])\t(.*)$", line)
        if stage:
            if stage.group(2) not in paths:
                paths.append(stage.group(2))
        elif line.startswith("CONFLICT ("):
            messages.append(line)
            named = re.search(r"Merge conflict in (.+)$", line)
            if named and named.group(1) not in paths:
                paths.append(named.group(1))
    return paths, messages


def measure(repo, a, b):
    """One pair, merged for real into a tree nobody keeps.

    Returns that tree's OID beside the conflicts, because `--against` merges
    the result AGAIN, onto the next branch. `merge-tree --write-tree` prints
    the OID on its first line whether or not the merge conflicted."""
    run = git(repo, "merge-tree", "--write-tree", a, b)
    tree = run.stdout.split("\n", 1)[0].strip() or None
    if run.returncode == 0:
        return tree, [], []
    paths, messages = conflicts_of(run.stdout)
    if not paths and not messages:
        # `merge-tree` exits 1 for a conflict AND for a merge it could not even
        # attempt — an unknown flag on a git older than 2.38, a ref that
        # disappeared between the check and here. Reading that as "clean" is
        # the exact lie this script was written to stop telling
        fail(f"`git merge-tree --write-tree {a} {b}` failed without naming a "
             f"conflict, so nothing was measured: "
             f"{(run.stderr or run.stdout).strip() or 'no output'}")
    return tree, paths, messages


def tail_of(output):
    """The last lines of a suite's output, which is where it says why."""
    return "\n".join(output.strip().splitlines()[-SUITE_TAIL_LINES:])


def commit_of(repo, tree, *parents):
    """A commit nobody keeps, wrapping a merged TREE.

    The tree alone is not enough twice over: `merge-tree` needs COMMITS to
    find a merge base for the second merge, and `git worktree add` checks out
    a commit."""
    argv = [*IDENTITY, "commit-tree", tree, "-m", "tk-collisions union"]
    for parent in parents:
        argv += ["-p", parent]
    run = git(repo, *argv)
    if run.returncode != 0:
        fail(f"`git commit-tree {tree}` could not wrap the merged tree, so "
             f"the union was not measured: "
             f"{(run.stderr or run.stdout).strip() or 'no output'}")
    return run.stdout.strip()


def union_of(repo, base, pivot, other):
    """The tree that exists after `pivot` lands on `base` and `other` follows.

    NOT `merge-tree pivot other`: that merge starts from
    `merge-base(pivot, other)`, the base as it stood when the two branched.
    Once the base has moved, that tree is missing everything that landed
    meanwhile — including the very test that grades the file, which is the
    collision this option was written to find. So the base is merged in
    first: `merge(merge(base, pivot), other)`.

    A conflict in EITHER step is the textual finding the pairwise path
    already reports, and it leaves no tree for a suite to run in."""
    tree, paths, messages = measure(repo, base, pivot)
    if paths or messages:
        return None, paths, messages
    landed = commit_of(repo, tree, base, pivot)
    tree, paths, messages = measure(repo, landed, other)
    if paths or messages:
        return None, paths, messages
    return tree, [], []


def run_suite(repo, tree, cmd):
    """`cmd`, run with the union as its working directory.

    NO TIMEOUT. A real gate runs one suite per open PR, minutes each, in the
    foreground; a wrapper that killed a slow one would report a union it
    never measured. A shell that cannot even start the command (126, 127) is
    a run that did not happen, never a red union."""
    commit = commit_of(repo, tree)
    path = tempfile.mkdtemp(prefix="tk-collisions-union.")
    try:
        add = git(repo, "worktree", "add", "--detach", path, commit)
        if add.returncode != 0:
            fail(f"the union {commit} could not be checked out into {path}, "
                 f"so the suite was not run: "
                 f"{(add.stderr or add.stdout).strip() or 'no output'}")
        try:
            run = subprocess.run(cmd, shell=True, cwd=path,
                                 capture_output=True, text=True)
        except OSError as e:
            fail(f"the suite could not be run in the union: {e}")
        if run.returncode in (126, 127):
            fail(f"`{cmd}` did not run in the union (the shell exited "
                 f"{run.returncode}), so nothing was measured: "
                 f"{(run.stderr or run.stdout).strip() or 'no output'}")
        return {"returncode": run.returncode,
                "tail": tail_of(run.stdout + run.stderr)}
    finally:
        git(repo, "worktree", "remove", "--force", path)
        shutil.rmtree(path, ignore_errors=True)


def unions(args):
    """One union per other branch, against the pivot `--against` names."""
    repo, pivot = args.repo, args.against
    others = [ref for ref in args.refs if ref != pivot]
    if not others:
        message = (f"only the pivot named ({pivot}), so there is no union to "
                   "measure — a lone PR lands on nobody")
        print(json.dumps({"pairs": [], "note": message}, ensure_ascii=False, indent=2)
              if args.json else f"## unions — {message}")
        return EXIT_OK

    pairs = []
    for other in others:
        tree, paths, messages = union_of(repo, args.base, pivot, other)
        pair = {"a": pivot, "b": other, "conflicts": bool(paths or messages),
                "paths": paths, "messages": messages, "suite": None}
        if tree is not None:
            pair["suite"] = run_suite(repo, tree, args.suite)
        pairs.append(pair)

    hit = [p for p in pairs
           if p["conflicts"] or (p["suite"] and p["suite"]["returncode"] != 0)]
    if args.json:
        print(json.dumps({"repo": repo, "against": pivot, "base": args.base,
                          "suite_command": args.suite, "pairs": pairs,
                          "counts": {"measured": len(pairs), "colliding": len(hit)}},
                         ensure_ascii=False, indent=2))
        return EXIT_FINDING if hit else EXIT_OK

    print(f"## unions — {len(pairs)} branch(es) merged onto {pivot} over "
          f"{args.base}, {len(hit)} that cannot land\n")
    for pair in pairs:
        if pair["conflicts"]:
            print(f"COLLIDES  {pair['a']} × {pair['b']}")
            for path in pair["paths"]:
                print(f"          {path}")
            for message in pair["messages"]:
                print(f"          {message}")
            continue
        if pair["suite"]["returncode"] != 0:
            print(f"RED       {pair['a']} × {pair['b']} — the union merges "
                  f"clean and `{args.suite}` exits "
                  f"{pair['suite']['returncode']} in it")
            for line in pair["suite"]["tail"].splitlines():
                print(f"          {line}")
            continue
        print(f"green     {pair['a']} × {pair['b']}")
    print("\nThe pivot lands FIRST here, by assumption. Another merge order "
          "is another run.")
    return EXIT_FINDING if hit else EXIT_OK


def collisions(args):
    repo = args.repo
    if git(repo, "rev-parse", "--git-dir").returncode != 0:
        fail(f"{repo} is not a git repository.")

    if args.against:
        missing = [flag for flag, value in (("--base", args.base),
                                            ("--suite", args.suite)) if not value]
        if missing:
            fail(f"--against needs {' and '.join(missing)}: the union is "
                 "`merge(merge(--base, --against), REF)` and only --suite "
                 "says whether it is green.")
    elif args.base or args.suite:
        given = " and ".join(flag for flag, value in (("--base", args.base),
                                                      ("--suite", args.suite)) if value)
        fail(f"{given} means nothing without --against, and answering the "
             "pairwise question under the name of the union would be the "
             "silence this script exists to break.")

    for ref in args.refs + [r for r in (args.against, args.base) if r]:
        if git(repo, "rev-parse", "--verify", "--quiet", ref + "^{commit}").returncode != 0:
            fail(f"{ref} names no commit in {repo}. Branches of open PRs live "
                 "under `origin/` until they are checked out — fetch first.")

    if args.against:
        return unions(args)

    if len(args.refs) < 2:
        message = (f"one branch named ({args.refs[0]}), so there is no pair to "
                   "measure — a lone PR collides with nobody")
        print(json.dumps({"pairs": [], "note": message}, ensure_ascii=False, indent=2)
              if args.json else f"## collisions — {message}")
        return EXIT_OK

    pairs = []
    for i, a in enumerate(args.refs):
        for b in args.refs[i + 1:]:
            _, paths, messages = measure(repo, a, b)
            pairs.append({"a": a, "b": b, "conflicts": bool(paths or messages),
                          "paths": paths, "messages": messages})

    hit = [p for p in pairs if p["conflicts"]]
    if args.json:
        print(json.dumps({"repo": repo, "pairs": pairs,
                          "counts": {"measured": len(pairs), "colliding": len(hit)}},
                         ensure_ascii=False, indent=2))
    else:
        print(f"## collisions — {len(pairs)} pair(s) merged by "
              f"`git merge-tree --write-tree`, {len(hit)} colliding\n")
        for pair in pairs:
            if not pair["conflicts"]:
                print(f"clean     {pair['a']} × {pair['b']}")
                continue
            print(f"COLLIDES  {pair['a']} × {pair['b']}")
            for path in pair["paths"]:
                print(f"          {path}")
            for message in pair["messages"]:
                print(f"          {message}")
        print("\nMerge order does not avoid a collision — it only chooses which "
              "PR pays for it.")
    return EXIT_FINDING if hit else EXIT_OK


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="tk-collisions",
        description="Merge every pair of branches for real, and name the pair "
                    "that cannot both land. The forge cannot answer this: its "
                    "`mergeable` field is blind between two PRs. With "
                    "--against, one UNION per other branch instead, graded by "
                    "--suite: the collision no merge can see, where a test one "
                    "branch adds grades a file another branch edits.")
    parser.add_argument("refs", nargs="+", metavar="REF",
                        help="the branches of the open PRs, usually `origin/<branch>`")
    parser.add_argument("--repo", default=".", metavar="DIR",
                        help="the repository (default: .)")
    parser.add_argument("--against", metavar="REF",
                        help="the PIVOT: the branch assumed to land FIRST. "
                             "Turns the run from every pair into one UNION "
                             "per other ref — `merge(merge(--base, pivot), "
                             "ref)` — each checked out and graded by --suite. "
                             "N-1 runs, not N²")
    parser.add_argument("--base", metavar="REF",
                        help="the branch the pivot lands ON, usually "
                             "`origin/main`. Required with --against: without "
                             "it the union misses whatever the base gained "
                             "since the branches were cut")
    parser.add_argument("--suite", metavar="CMD",
                        help="the shell command that says whether a union is "
                             "green, run with the union as its working "
                             "directory. Required with --against, and given "
                             "no timeout")
    parser.add_argument("--json", action="store_true",
                        help="the same answer, for a reader")
    return collisions(parser.parse_args(argv))


if __name__ == "__main__":
    sys.exit(main())
