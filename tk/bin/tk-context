#!/usr/bin/env python3
"""tk-context — how full is THIS session's context window, in tokens.

WHY IT EXISTS: `WINDOW.md` asks the orchestrator to read the context number at
every seam, and for three generations no orchestrator could. The number is in
the statusline, and the statusline is rendered to the user's terminal — it never
enters the model's context. Measured 2026-09-03: three generations in a row
reported the number as estimated, unread, or `n/m`, and the third then cited a
threshold it had never read. This command is the reading the rule always meant.

WHERE THE NUMBER COMES FROM: the session's own transcript. Claude Code records
the `usage` of every API response there, and the shell environment carries
`CLAUDE_CODE_SESSION_ID`, which names the file. The occupancy is
`input_tokens + cache_creation_input_tokens + cache_read_input_tokens` — the
formula the official statusline documentation declares for
`context_window.total_input_tokens`. Cross-checked twice against a rendered
statusline on 2026-09-03: 290,286 against 293k, and 86k → 90k → 98k across one
session's calls.

ABSOLUTE, NEVER A PERCENTAGE. The threshold this feeds measures the SMART ZONE —
judgement degrading — not the window running out, so it does not scale with the
window. On a 1M-context model 293k reads as 29%, and an orchestrator comparing
that against "~150-200k" concludes it has room while sitting well past the
ceiling. So this command prints tokens and no fraction.

WHAT IT DOES NOT SEE: subagents. Their transcripts are not in the parent's file
(measured: 206 entries, zero `isSidechain`, five subagents dispatched), and their
windows are their own. The `subagent_tokens` a run reports measure that run, not
this session. Nor does it see the turn in flight: the newest entry is the last
response the API has already sent, so the number lags the live statusline by
about one turn, always LOW. A seam sitting on the threshold should read the lag
as room it does not have.

Usage:  tk-context [--curve] [--session ID] [--transcript PATH]
Exit:   0 the number is printed · 2 no number is available
"""

import argparse
import glob
import json
import os
import sys

EXIT_OK = 0
EXIT_NO_NUMBER = 2

# The three input counters the window holds. Output tokens are excluded on
# purpose: the documented `used_percentage` is input-only, and matching it is
# what lets this number be compared against a statusline reading.
INPUT_FIELDS = ("input_tokens", "cache_creation_input_tokens",
                "cache_read_input_tokens")


def no_number(msg):
    """Stop with code 2, and say what the caller owes instead of the number.

    The message is half the point. A seam that cannot read the number is not
    licensed to invent one: it decides by judgement and SAYS it is judgement,
    which is the failure this whole command exists to answer.
    """
    print(f"tk-context: {msg}", file=sys.stderr)
    print("tk-context: no number — decide by judgement, and say it is judgement",
          file=sys.stderr)
    sys.exit(EXIT_NO_NUMBER)


def find_transcript(session_id):
    """The jsonl for one session id, under any project directory."""
    root = os.path.expanduser("~/.claude/projects")
    hits = sorted(glob.glob(os.path.join(root, "*", f"{session_id}.jsonl")))
    if not hits:
        no_number(f"no transcript for session {session_id} under {root}")
    return hits[0]


def occupancies(path):
    """Every recorded occupancy of this session's window, oldest first.

    Read line by line: a long session's transcript reaches megabytes, and only
    the counters are wanted. Malformed lines are skipped rather than fatal —
    a transcript is appended to live, so the last line can be half-written.
    """
    out = []
    try:
        handle = open(path, errors="replace")
    except OSError as exc:
        no_number(f"cannot read {path}: {exc}")
    with handle:
        for line in handle:
            try:
                record = json.loads(line)
            except ValueError:
                continue
            # Belt and braces: subagent entries are not written here today, and
            # the file being keyed by this session's id is the real guarantee.
            if record.get("isSidechain"):
                continue
            usage = (record.get("message") or {}).get("usage")
            if not isinstance(usage, dict):
                continue
            total = sum(usage.get(f, 0) or 0 for f in INPUT_FIELDS)
            if total:
                out.append((record.get("timestamp") or "", total))
    return out


def print_curve(points, rows=6):
    """The slope, not just the height.

    A seam reading one number cannot tell 15k a step from 40k a step, and it is
    the slope that decides whether another review fits before the ceiling.
    """
    if len(points) < 2:
        return
    step = max(1, (len(points) - 1) // (rows - 1))
    sampled = points[::step]
    if sampled[-1] is not points[-1]:
        sampled.append(points[-1])
    print("curve (oldest first):", file=sys.stderr)
    previous = None
    for stamp, total in sampled:
        delta = "" if previous is None else f"  {total - previous:+d}"
        print(f"  {stamp[:19] or '?':19}  {total:>9,d}{delta}", file=sys.stderr)
        previous = total


def main():
    parser = argparse.ArgumentParser(
        description="print this session's context occupancy, in tokens")
    parser.add_argument("--curve", action="store_true",
                        help="also print the occupancy over the session, on stderr")
    parser.add_argument("--session", default=os.environ.get("CLAUDE_CODE_SESSION_ID"),
                        help="session id (default: $CLAUDE_CODE_SESSION_ID)")
    parser.add_argument("--transcript",
                        help="read this jsonl instead of resolving the session id")
    args = parser.parse_args()

    path = args.transcript
    if not path:
        if not args.session:
            no_number("no CLAUDE_CODE_SESSION_ID in the environment")
        path = find_transcript(args.session)

    points = occupancies(path)
    if not points:
        no_number(f"no API response recorded yet in {path}")

    print(f"{points[-1][1]} tokens in context")
    if args.curve:
        print_curve(points)
    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
